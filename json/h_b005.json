 "songs": [
  {
   "src": "p0020l.png",
   "num": "22",
   "title": "Люблю я весть благую",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Люблю я весть благую,",
      "Слова и звуки те,",
      "Что миру повествуют",
      "О Господе Христе.",
      "Люблю Господне Слово",
      "Передавать другим,",
      "Оно всему основа,",
      "И мир наш создан Им."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Люблю я весть благую",
      "Из Библии читать,",
      "Мне душу оживляет",
      "Господня благодать.",
      "Люблю делиться вестью",
      "О Божьей доброте,",
      "Как Он дарует людям",
      "Спасенье во Христе."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Люблю я весть благую,",
      "Душа моя поёт,",
      "Я верю: Сам Спаситель",
      "В пути меня ведёт.",
      "И скоро Он во славе",
      "При звуках неземных",
      "Введёт в Свою обитель",
      "Искупленных святых."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Люблю я весть благую,",
      "Что миру Бог послал,",
      "Как наш Господь-Спаситель",
      "Нас, грешных, оправдал."
     ]
    }
   ]
  },
  {
   "src": "p0020r.png",
   "num": "23",
   "title": "О Слово Божие",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О Слово Божие,",
      "Отраду ты даёшь;",
      "Ты яркий свет в моём пути,",
      "К блаженству ты ведёшь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Сокровище моё,",
      "Путеводитель мой,",
      "В тебе надежду я обрёл,",
      "Защиту и покой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Святая благодать",
      "Теперь всегда со мной;",
      "И я у ног Христа избрать",
      "Могу удел благой."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ты освещаешь путь,",
      "Ты свет стезе моей;",
      "Наставником моим пребудь",
      "Во все дни жизни сей."
     ]
    }
   ]
  },
  {
   "src": "p0021l.png",
   "num": "24",
   "title": "О, Слово дорогое!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О, Слово дорогое! О, зов любви святой –",
      "В нём скрыто неземное блаженство и покой.",
      "Всем бедным, утруждённым на жизненном пути",
      "Дарует утешенье тот зов Христа: «Приди!»"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Те сладостные звуки влекут нас к небесам,",
      "Где мы забудем муки, найдём покой сердцам.",
      "Тревогу и сомненье, мой друг, ты победи",
      "И слушай зов спасенья, тот зов Христа: «Приди!»"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О Боже, дай мне силы принять небесный свет",
      "И верно до могилы хранить святой завет.",
      "В чудесный край желанный Ты сам меня веди",
      "И дай мне там услышать Твой нежный зов: «Приди!»"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О, приди к Христу! О, приди к Христу!",
      "Бедный, утруждённый, о, приди к Христу!",
      "О, приди к Христу! О, приди к Христу!",
      "Бедный, утруждённый, о, приди к Христу!"
     ]
    }
   ]
  },
  {
   "src": "p0022l.png",
   "num": "25",
   "title": "В Слове Божьем ищи утешенье",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В Слове Божьем ищи утешенье, друг мой,",
      "В непрерывной житейской борьбе;",
      "Если больно порой, если страшно тебе,",
      "Прибегай Ты к Нему всей душой."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Лишь на Христа",
      "В Слове Божьем взирай,",
      "Каждый день, о друг мой,",
      "Слово Божье читай."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В Слове Божьем ищи путь к спасенью, друг мой,",
      "Через веру в Иисуса Христа;",
      "Кровь святая Его, что стекала с креста,",
      "Даст прощенье тебе и покой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Слово Божье всегда будет светом тебе",
      "На нелёгкой дороге твоей,",
      "Маяком среди бурь и житейских скорбей,",
      "Другом верным на грешной земле."
     ]
    }
   ]
  },
  {
   "src": "p0022r.png",
   "num": "26",
   "title": "Люблю читать я книгу",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Люблю читать я книгу –",
      "Святую Библию;",
      "Она путеводитель",
      "В страну небесную."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Как люблю, как люблю",
      "Я Библию всей душою,",
      "И, как лань, к ней стремлюсь,",
      "И живую воду пью."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В ней мир и утешенье",
      "Для страждущих людей;",
      "Она маяк спасенья",
      "Во тьме средь волн страстей."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Она мой верный спутник",
      "На жизненном пути;",
      "Советы, наставленья",
      "Могу я в ней найти."
     ]
    }
   ]
  },
  {
   "src": "p0023l.png",
