 "songs": [
  {
   "src": "p0034l.png",
   "num": "43",
   "title": "У креста, Спаситель мой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "У креста, Спаситель мой,",
      "Пребывать желаю;",
      "Там родник любви святой",
      "Сердце исцеляет."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "У креста любовь Твоя",
      "Жизнь всю изменила,",
      "Сердце гордое моё",
      "Навсегда пленила."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "У креста открылась мне",
      "Благодать святая:",
      "За меня молился Ты,",
      "Кровью истекая."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "У креста я получил",
      "Дивный дар спасенья;",
      "У креста желаю ждать",
      "Твоего явленья."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "У креста, у креста",
      "Всех грехов прощенье;",
      "У креста душа нашла",
      "Мир, успокоенье."
     ]
    }
   ]
  },
  {
   "src": "p0034r.png",
   "num": "44",
   "title": "Глава в венце терновом",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Глава в венце терновом",
      "И лик святой в крови –",
      "Творец так коронован",
      "Творением Своим.",
      "Владыка всей Вселенной,",
      "Небесных сонмов Царь",
      "Рабами зла и тленья",
      "Возложен на алтарь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "За что Ты так унижен,",
      "За что Ты осуждён,",
      "Избит, обезображен",
      "И к древу пригвождён?",
      "Ты мучим, истязуем",
      "За грех, за тяжкий мой,",
      "Безвинный, наказуем",
      "За грешного – Святой!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Те муки созерцая,",
      "Сражённый ум молчит.",
      "Тебя благословляя,",
      "Душа моя горит –",
      "Горит святым желаньем",
      "К ногам Твоим припасть:",
      "Ты мукой и страданьем",
      "Наш мир навеки спас."
     ]
    }
   ]
  },
  {
   "src": "p0035l.png",
   "num": "45",
   "title": "Лишь Один приходил на кресте умереть",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Лишь Один приходил на кресте умереть,",
      "Чтоб от смерти меня искупить;",
      "Шёл покорно на казнь, согласился терпеть,",
      "Чтоб грехи моей жизни покрыть."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Терпеливо и нежно Он учит меня",
      "И даёт благодатных мне сил.",
      "Осужденья мне нет, Он – защита моя,",
      "Все грехи ко кресту пригвоздил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Я пришёл ко Христу, с Ним пребуду всегда,",
      "Каждый день я иду вслед за Ним",
      "С ликованьем в душе и хвалой на устах,",
      "Что мои все грехи Он простил."
     ]
    }
   ]
  },
  {
   "src": "p0035r.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Ко кресту пригвождён, ко кресту пригвождён!",
      "За меня был замучен Христос,",
      "Был поруган, презрен, ко кресту пригвождён,",
      "Но грехи Он на древо вознёс."
     ]
    }
   ]
  }
 ]
}