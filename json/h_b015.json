 "songs": [
  {
   "src": "p0044l.png",
   "num": "58",
   "title": "Божий Сын Единородный",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Божий Сын Единородный –",
      "Всей Вселенной Он Творец.",
      "Он есть Альфа и Омега,",
      "Он Начало и Конец.",
      "Всё, что было, есть и будет –",
      "Это всё Его любовь",
      "Ныне и вовек веков!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О безгрешных воинств сонмы,",
      "Преклонитесь перед Ним!",
      "В восхищении падите",
      "Перед Дивным и Святым!",
      "Неумолчно воспевайте",
      "Бесконечную любовь",
      "Ныне и вовек веков! Аминь."
     ]
    }
   ]
  },
  {
   "src": "p0045l.png",
   "num": "59",
   "title": "На утренней заре",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "На утренней заре",
      "Мой дух поёт Тебе –",
      "Прославлен будь, Иисус!",
      "Господь, душа моя",
      "Открыта для Тебя –",
      "Прославлен будь, Иисус!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "С Тобой и ночь, как день,",
      "Уходит скорби тень –",
      "Прославлен будь, Иисус!",
      "Трепещут силы тьмы,",
      "Когда взываем мы:",
      "Прославлен будь, Иисус!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Внимай, небесный свод –",
      "Хор ангелов поёт:",
      "Прославлен будь, Иисус!",
      "И вторит песне той",
      "Спасённый шар земной:",
      "Прославлен будь, Иисус!"
     ]
    }
   ]
  },
  {
   "src": "p0045r.png",
   "num": "60",
   "title": "Иисус, Тебе лишь слава!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Иисус, Тебе лишь слава!",
      "Крестной смертью Ты Своей",
      "Дал надежду мне и право",
      "Быть средь Божиих детей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Долго я, во тьме блуждая,",
      "О любви Твоей не знал;",
      "Я не знал, что, умирая,",
      "Ты Своим меня назвал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Я к ногам Твоим, рыдая,",
      "Как Мария, припаду;",
      "В благодати возрастая,",
      "От Тебя не отойду."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Иисус, Тебе лишь слава!",
      "Ты искал меня и звал.",
      "Иисус, Тебе лишь слава!",
      "За меня Ты жизнь отдал."
     ]
    }
   ]
  }
 ]
}