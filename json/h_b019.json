  {
   "src": "p0058l.png",
   "num": "77",
   "title": "О дивный мой Спаситель!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О дивный мой Спаситель!",
      "Ты песнь хвалы моей,",
      "Единый Утешитель",
      "Средь бедствий и скорбей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Лишь Ты – моя надежда",
      "Во дни тяжёлых бед,",
      "И если мрак окружит,",
      "Ты даришь сердцу свет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Тебе я доверяю,",
      "Ты верный Вождь в пути,",
      "И к небу, к жизни вечной",
      "Поможешь мне дойти."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ты мне всего дороже,",
      "Дороже, чем весь мир,",
      "Тебя я славить буду,",
      "Придя на брачный пир."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О дивный мой Спаситель!",
      "Ты песнь хвалы моей,",
      "Нет в мире этом друга",
      "Дороже и верней."
     ]
    }
   ]
  },
  {
   "src": "p0058r.png",
