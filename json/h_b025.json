 "songs": [
  {
   "src": "p0088l.png",
   "num": "130",
   "title": "Святой день Господень",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Святой день Господень, небесный покой,",
      "Он радость приносит уставшим душой.",
      "Его приближенье рождает во мне",
      "Блаженство и счастье в святой тишине."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Царь мира сегодня нам Вестника шлёт,",
      "Нас, грешных, к Спасителю всех Он зовёт.",
      "Дух Божий здесь веет, в сердцах жизнь творит,",
      "И мир Свой небесный Спаситель дарит."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В субботу мы здесь предвкушаем покой,",
      "В который введёт нас Отец Всеблагой.",
      "И в день, когда в славный покой тот войдём,",
      "С любовью Христу гимн хвалы воспоём."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Славу, славу,",
      "Славу вовек",
      "За день сей святой да воздаст человек!"
     ]
    }
   ]
  },
  {
   "src": "p0088r.png",
   "num": "131",
   "title": "В день Твой субботний",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В день Твой субботний, святой, освящённый,",
      "Я прибегаю к Тебе, мой Христос –",
      "Радость и мир Ты душе истомлённой",
      "Шлёшь в этот день средь страданий и слёз."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай Ты мне силы, любви и терпенья",
      "Быть Твоим верным, послушным рабом",
      "И в день святой прославлять в песнопеньях",
      "Дивную милость Твою с торжеством."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О, удостой пред Тобою явиться",
      "С жертвой хваления – даром святым –",
      "И пред престолом Твоим преклониться",
      "Вместе с народом смиренным Твоим."
     ]
    }
   ]
  },
  {
   "src": "p0089l.png",
   "num": "132",
   "title": "Наполняет сердце радость",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Наполняет сердце радость,",
      "И хвалу поют уста,",
      "Когда вижу я сквозь дымку",
      "Голубые небеса."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Когда слышу птичек пенье,",
      "Когда вижу солнца луч,",
      "Исчезают все волненья –",
      "О, как мой Господь могуч!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Будем славить в песнопеньях",
      "Мудрость нашего Творца,",
      "Вознесём к Нему в молитвах",
      "Благодарные сердца!"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "В день субботний, в день отрадный",
      "Отступает суета,",
      "И покой небесный сходит",
      "На уставшие сердца."
     ]
    }
   ]
  },
  {
   "src": "p0089r.png",
   "num": "133",
   "title": "Аллилуйя, день субботний (II)",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Аллилуйя, день субботний,",
      "День прекраснее других,",
      "Драгоценный дар Господний,",
      "Отдых от трудов мирских.",
      "День сей святостью своей",
      "Мир несёт душе моей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Чудный день отдохновенья,",
      "Благодатный день святой!",
      "Ныне нам благословенье,",
      "Боже, щедрой лей рукой.",
      "И мольбу, и гимн хвалы,",
      "Боже, Ты от нас прими."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "День святой с благодареньем,",
      "Боже, нам закончить дай",
      "И с небес благословенье",
      "Мерой полною подай.",
      "В царстве вечном пред Тобой",
      "Будем чтить сей день святой."
     ]
    }
   ]
  },
  {
   "src": "p0090l.png",
   "num": "134",
   "title": "Странствуя здесь, на чужбине",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Странствуя здесь, на чужбине,",
      "Гимн надежды я пою,",
      "В день святой Господень ныне",
      "Богу славу воздаю."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Только грешник, искуплённый",
      "Милосердием Творца,",
      "Может искренно, достойно",
      "Славить нашего Отца."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Дай и мне, о Боже Вечный,",
      "Ныне в Твой покой войти,",
      "В славословиях сердечных",
      "Слабый голос вознести."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Все заботы и печали",
      "Отступили далеко;",
      "К небу взор я направляю –",
      "И на сердце так легко!"
     ]
    }
   ]
  },
  {
   "src": "p0090r.png",
   "num": "135",
   "title": "Как кратки всё ж прекрасные мгновенья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Как кратки всё ж прекрасные мгновенья",
      "Субботнего покоя на земле!",
      "В земной юдоли день сей – утешенье,",
      "Грядущей славы весть несёт он мне."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О Боже, пусть Твой Дух мной управляет,",
      "Веди меня по правому пути;",
      "Дай твёрдость мне, когда враг угрожает,",
      "К блаженной цели, Боже, дай дойти."
     ]
    }
   ]
  },
  {
   "src": "p0091l.png",
