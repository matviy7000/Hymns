  {
   "src": "p0131r.png",
   "num": "203",
   "title": "Живи во мне, Спаситель",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Живи во мне, Спаситель,",
      "Владыка, Царь царей –",
      "Хочу я быть водимым",
      "Десницею Твоей.",
