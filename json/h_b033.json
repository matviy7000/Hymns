    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "На пути в небесный край,",
      "Словно солнце, нам сияй,",
      "Свет и жизнь – в Тебе одном,",
      "Боге дивном и святом."
     ]
    }
   ]
  },
  {
   "src": "p0130l.png",
   "num": "199",
   "title": "Милосердный Творец",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Милосердный Творец,",
      "Слаб и немощен я,",
      "Но Ты, добрый Отец,",
      "Укрепляешь меня."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты мой дух просвети",
