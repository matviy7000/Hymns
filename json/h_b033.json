 "songs": [
  {
   "src": "p0128l.png",
   "num": "194",
   "title": "Господь, Тебя люблю",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь, Тебя люблю",
      "И песнь Тебе пою.",
      "О Боже мой, молю:",
      "Услышь меня!",
      "Ты по Своей любви",
      "Милость ко мне яви –",
      "Дух сердца обнови,",
      "Ведь грешен я."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Услыши голос мой,",
      "Прошу Тебя с мольбой:",
      "Дай жертвовать собой",
      "В делах святых.",
      "Всё, чем я дорожу,",
      "Тебе я приношу;",
      "Как жертву всё сложу",
      "У ног Твоих."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Господь, пребудь со мной",
      "Здесь, в страшной тьме земной,",
      "Чтоб мне идти тропой",
      "В град золотой.",
      "Пусть грозный враг страшит",
      "И зло кругом кипит –",
      "Ты, верный, крепкий щит,",
      "Всегда со мной!"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Господь, приди ко мне –"
     ]
    }
   ]
  },
  {
   "src": "p0128r.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Ты мощь моя!",
      "О, помоги в борьбе –",
      "Я жду Тебя!"
     ]
    }
   ]
  },
  {
   "src": "p0128r.png",
   "num": "195",
   "title": "Будь милосерд, о Боже мой!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Будь милосерд, о Боже мой!",
      "Услышь мой зов к Тебе с мольбой,",
      "Дай искушенье победить",
      "И веру чистой сохранить."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Тебя молю я, Боже мой,",
      "Даруй мне верою живой",
      "Смиренно в истине ходить",
      "И всей душой Тебя любить."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пока живу я на земле,",
      "Дай верным быть во всём Тебе:",
      "Твою святую волю чтить,",
      "Всю жизнь Тебе лишь посвятить."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Пошли мне силы, Боже мой,",
      "Исполнить Твой Закон святой;",
      "Молю – во мне дух обнови",
      "И укрепи в Твоей любви."
     ]
    }
   ]
  },
  {
   "src": "p0129l.png",
   "num": "196",
   "title": "Удали мои сомненья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Удали мои сомненья,",
      "Что приходят иногда.",
      "Боже добрый, дай прозренье",
      "И развей их без следа."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Если мне порою трудно",
      "Принимать пути Твои,",
      "Рядом будь, Господь, и чудно",
      "К вечной цели доведи."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Я всецело доверяюсь",
      "Провиденью Твоему,",
      "На Тебя лишь полагаюсь,",
      "Всё от рук Твоих приму."
     ]
    }
   ]
  },
  {
   "src": "p0129r.png",
   "num": "197",
   "title": "Любовь Твоя, Спаситель мой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Любовь Твоя, Спаситель мой,",
      "Душе моей даёт покой.",
      "Мой разум, дух и жизнь мою",
      "В Твои я руки отдаю.",
      "Прими меня, Господь!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты светом ярким засвети",
      "Мой факел, гаснущий в пути,",
      "В надежде, вере утверди,",
      "К блаженной цели приведи.",
      "Веди меня, Господь!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О, крест, влекущий ввысь мой дух!",
      "Земное меркнет всё вокруг,",
      "Душа становится чиста",
      "Здесь, у подножия креста.",
      "Омой меня, Господь!"
     ]
    }
   ]
  },
  {
