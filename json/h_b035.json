  {
   "src": "p0139r.png",
   "num": "217",
   "title": "Хочу с Тобой быть",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Хочу с Тобой быть там, где Ты,",
      "Боже Предвечный – мой оплот,",
      "Где радость вечная царит,",
      "Где нет мучительных невзгод."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Хочу с Тобой быть там, где Ты,",
      "Чтоб насладиться красотой,",
      "Где все уста хвалой полны,",
      "Где льётся песнь живой рекой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Хочу с Тобой быть там, где Ты,",
      "Где нет разлуки, нет тоски,",
      "Где жизнь наполнена хвалой,",
      "Блаженством вечным и Тобой!"
     ]
    }
   ]
  },
  {
