 "songs": [
  {
   "src": "p0143l.png",
   "num": "222",
   "title": "Я знаю святую обитель",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я знаю святую обитель",
      "И Богом обещанный рай;",
      "Зовёт нас туда Сам Спаситель –",
      "Войти в благодатный тот край."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Спаситель во славе небесной",
      "Уж скоро на землю придёт,",
      "И в край благодатный, чудесный",
      "Свой верный народ Он введёт."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Господь нас в любви бесконечной",
      "От вечной погибели спас,",
      "Он в светлой отчизне небесной",
      "Готовит обитель для нас."
     ]
    }
   ]
  },
  {
   "src": "p0143r.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Там не будет невзгод и ненастья,",
      "Сам Господь наши слёзы отрёт,",
      "Мир великий и светлое счастье",
      "Всякий страждущий там найдёт."
     ]
    }
   ]
  },
  {
   "src": "p0144l.png",
   "num": "223",
   "title": "Пред нами, братья, Иордан",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Пред нами, братья, Иордан,",
      "Пустыню мы прошли,",
      "Вдали уж виден Ханаан,",
      "К нему мы подошли."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И Иерихон могуч падёт,",
      "И станет Иордан,",
      "Когда Господь Сам поведёт",
      "Народ Свой в Ханаан."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Немного нам осталось ждать –",
      "Мы в край святой войдём.",
      "Любовь Господню воспевать",
      "Там будем с торжеством."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "В той стране после скорби отдохнём,",
      "Перейдя через бурный Иордан,",
      "Песню Агнца, Моисея там воспоём,",
      "Наполним пеньем Ханаан."
     ]
    }
   ]
  },
  {
   "src": "p0144r.png",
   "num": "224",
   "title": "Мы у источника спасенья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Мы у источника спасенья,",
      "У светлых, чистых вод.",
      "Уж скоро встретим Иисуса",
      "Вдали от всех невзгод."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И путь земной – тернистый, скорбный –",
      "Мы сменим на покой",
      "На берегах реки небесной –",
      "Реки воды живой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Там древо жизни над рекою",
      "На светлых берегах –",
      "Найдут уставшие душою",
      "Покой на небесах."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Там, где источник вечной жизни,",
      "Где источник вечной жизни,",
      "Где источник вечной жизни,",
      "Там мы будем обитать."
     ]
    }
   ]
  },
  {
   "src": "p0145l.png",
   "num": "225",
   "title": "Свет после мрака",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Свет после мрака, тишь за грозой,",
      "Сила за слабостью жизни земной,",
      "Сладость за горьким, песнь после слёз,",
      "После скитанья ждёт верных Христос."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Плод за посевом, пир за трудом,",
      "Дождь после засухи, луч за дождём,",
      "Благословенье после потерь –",
      "Милостив к нам Господь, о друг, поверь."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Близость за далью; после невзгод",
      "Сладкий покой и мир Бог нам даёт.",
      "После победы – слава венца,",
      "После волненья здесь – мир у Христа."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Скоро настанет славный конец,",
      "Скоро получим мы жизни венец.",
      "Слава, всесильный Спаситель мой!",
      "Всюду, где Ты идёшь, мы за Тобой."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Здесь льются слёзы –",
      "Там стихнут грозы.",
      "Здесь труден путь земной –",
      "Там ждёт покой."
     ]
    }
   ]
  },
  {
   "src": "p0145r.png",
   "num": "226",
   "title": "Над кристальною рекою",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Над кристальною рекою,",
      "У прозрачных чистых вод",
      "Встретимся ли мы с тобою,",
      "Где течёт живой поток?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "У святой реки небесной",
      "Будет правда обитать,",
      "Сонм спасённых будет вечно",
      "Божью милость возвещать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Скоро мы реки достигнем,",
      "Путь скорбей придёт к концу,",
      "И тогда в чудесном гимне",
      "Воспоём хвалу Творцу."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Да, над дивною рекою,",
      "Где наш Спаситель соберёт спасённых,",
      "Там мы встретимся с тобою",
      "Пред вечным престолом Творца."
     ]
    }
   ]
  },
  {
   "src": "p0146l.png",
   "num": "227",
   "title": "Быть вместе со Христом",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Быть вместе со Христом",
      "Стремлюсь я всей душой –",
      "Явиться пред Его лицо,",
      "Взирать на лик святой.",
      "Хочу услышать я",
      "Небесный дивный хор,",
      "Хочу, Спаситель,"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Я поднимаю взор",
      "К отчизне в небесах",
      "И вижу радужный простор,",
      "Сияющий в лучах.",
      "О родина моя!",
      "О дивный край святой!",
      "Когда увижу"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "«Быть вместе со Христом, –",
      "Молю, – дай, Отче, мне!»",
      "Здесь на земном пути моём",
      "К родной стремлюсь стране.",
      "В опасностях храня,",
      "Ты мне даёшь покой",
      "И, верю, приве-"
     ]
    }
   ]
  },
