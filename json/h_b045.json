   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "У реки, у Иордана,",
      "Пред Тобою мы стоим",
      "И к отчизне Ханаана",
      "Путь направить свой хотим."
     ]
    }
   ]
  },
  {
