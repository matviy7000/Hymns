 "songs": [
  {
   "src": "p0193l.png",
   "num": "298",
   "title": "В день сей воспеваем",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В день сей воспеваем",
      "Дар любви святой,",
      "Вместе вспоминаем",
      "Вечный подвиг Твой.",
      "Душу раскрываем",
      "Истине святой,",
      "Сердце изливаем,",
      "Боже, пред Тобой."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Очи поднимаем",
      "К небу в этот час.",
      "Сердцем ожидаем –",
      "О, призри на нас!",
      "Мы ослабеваем,",
      "Тяжко нам подчас –",
      "Боже, умоляем,",
      "Оживи Ты нас!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Вечерю святую",
      "С нами раздели,",
      "Верой и любовью",
      "Всех нас надели.",
      "Тайный дух гордыни,",
      "Боже, удали,",
      "Дай нам быть отныне",
      "Светочем земли."
     ]
    }
   ]
  },
  {
   "src": "p0193r.png",
   "num": "299",
   "title": "В тот вечер пред Пасхой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В тот вечер пред Пасхой на грешной земле",
      "Заката лучи догорали во мгле.",
      "О мире небесном Господь говорил",
      "И пыльные ноги апостолам мыл."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Великий Владыка земли и небес",
      "За наши грехи пригвождён был на крест,",
      "Он зло и неверье порочных людей",
      "Очистил невинною Кровью Своей."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Он в схватке со смертью на грубом кресте",
      "Молился Отцу не о праведной мзде –",
      "Господь о прощенье молился в тот час",
      "За всех тех, кого Он от гибели спас."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Хочу, как Христос, всех прощать и любить,",
      "Хочу бескорыстным и праведным быть,",
      "Оставить вражду и обиды забыть,",
      "Заветы Спасителя свято хранить."
     ]
    }
   ]
  },
  {
   "src": "p0194l.png",
   "num": "300",
   "title": "Ты нам Свои заветы",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
