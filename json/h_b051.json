  {
   "src": "p0219r.png",
   "num": "347",
   "title": "Мой Христос-Спаситель",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Мой Христос-Спаситель",
      "Умер за меня",
      "И в Свою обитель",
      "Примет и меня."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Любит мой Спаситель",
