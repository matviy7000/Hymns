 "songs": [
  {
   "src": "p0020.png",
   "num": "20",
   "title": "Мой Бог мне в жизни сила",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Мой Бог – мне жизни сила,",
      "Ему хвалу пою",
      "Отныне до могилы,",
      "Доколе я живу."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он – высший дар священный,",
      "Дарованный Отцом,",
      "Им свыше одаренный,",
      "Я счастлив в мире сем."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Он Духом обитает",
      "Во мне Своим Святым.",
      "Меня Он озаряет",
      "Блаженством неземным."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Меня Он исцеляет",
      "От тяжких ран греха,",
      "И кровью омывает,",
      "Пролитой со креста."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Он – хлеб и вода жизни,",
      "Мой свет средь темноты,",
      "Мой путь к вратам Отчизны,",
      "Победа средь борьбы."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "Мой Пастырь и Водитель,",
      "Священник и Алтарь,",
      "Господь мой и Спаситель,",
      "Защитник мой и Царь."
     ]
    },
    {
     "label": "7 КУПЛЕТ",
     "lines": [
      "Он – счастье и отрада,",
      "Мой гимн и мой псалом,",
      "Мой труд, моя награда,",
      "Мое Он все во всем."
     ]
    },
    {
     "label": "8 КУПЛЕТ",
     "lines": [
      "И что лишь пожелаю,",
      "Я в Нем одном найду,",
      "Его я воспеваю,",
      "Доколе я живу."
     ]
    }
   ]
  },
  {
   "src": "p0021.png",
   "num": "21",
   "title": "Когда я устремляю взоры",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Когда я устремляю взоры",
      "На снеговые вечно горы,",
      "Мне ясно в глубине сердечной:",
      "Господь создал их силой вечной,",
      "Чтоб я, взглянув на них, познал,"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Когда смотрю на туч движенье,",
      "На их полет и устремленье,",
      "Мне тайный голос возвещает:",
      "Господь чрез них мне открывает,",
      "Чтоб к небесам от суеты"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Когда я вижу вод теченье",
      "И шум их бурного движенья,",
      "Я слышу голос Божьей воли,",
      "Чтоб я, живя в земной юдоли,",
      "Пути к Нему лишь направлял"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Когда пред мною круг обширный",
      "Красы природы чудной, мирной,",
      "Тогда я постигаю снова",
      "Всю силу творческого Слова",
      "И вновь склоняюсь пред Тобой"
     ]
    }
   ]
  },
  {
   "src": "p0022.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Как я ничтожен, как я мал."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Неслись все мысли и мечты."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И на Него лишь уповал."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "С неумолкающей хвалой."
     ]
    }
   ]
  },
  {
   "src": "p0022.png",
   "num": "22",
   "title": "Господь – мой Друг",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь – мой Друг, и я смиряюсь",
      "В несчастье, горе и нужде;",
      "Его я силой укрепляюсь,",
      "Как и Спаситель на кресте.",
      "Греховный долг Он мой прощает,",
      "Вину мою с меня снимает."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И неужели мне бояться,",
      "Когда Господь всегда со мной?",
      "Я за Него хочу держаться,",
      "В тревоге Он мне даст покой.",
      "Для всех Своих Он – щит надежный,",
      "Убежище от бури грозной."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Здесь на земле удел наш труден,",
      "Грех нас во всем поработил,",
      "Но наш Господь так дивен, чуден,",
      "Вину Он нашу с нас омыл.",
      "Он уготовил мне обитель,",
      "Он – мой Господь, Он – мой Спаситель."
     ]
    }
   ]
  },
  {
   "src": "p0023.png",
   "num": "23",
   "title": "Бог – Отец любвеобильный",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Бог – Отец любвеобильный,",
      "Любит нежно Он меня",
      "И хранит рукою сильной,",
      "Как Отец Свое дитя."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Водой жизни напояет",
      "Из источников Он Сам,",
      "Путь к блаженству направляет,",
      "Свет дает моим стезям."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Подкрепляет Своей силой,",
      "Чтоб в борьбе я мог стоять,",
      "Хоть пойду я той долиной,",
      "Где лишь зло и смерть царят."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Мой Господь всегда со мною,",
      "Он – защитник верный мой,",
      "И ведет меня к покою,",
      "В царство правды, в дом родной."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Отдаюсь Ему душою,",
      "Буду с Ним лишь в мире жить,",
      "Чтоб державною рукою",
      "Мог меня Он сохранить."
     ]
    }
   ]
  },
  {
   "src": "p0024.png",
   "num": "24",
   "title": "Всем сердцем и душой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Всем сердцем и душой",
      "Благодарите Бога,",
      "Он – наш Отец благой,",
      "Нас одаряет много.",
      "Уж с детства Он от зла",
      "С любовью охранял,",
      "И дивно, без числа,",
      "Он нас благословлял."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О вечно добрый Бог,",
      "В сей жизни скоротечной",
      "Даруй, чтобы я мог",
      "Иметь покой сердечный,",
      "И благостью Твоей",
      "Храни, не оставляй;",
      "От всех земных скорбей",
      "Нас, Боже, избавляй."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Достойно восхвалить",
      "Отца и Сына вечно;",
      "Кто может равным быть",
      "Тому, Кто так сердечно",
      "Питает к нам любовь?",
      "Он нашу жизнь хранит,",
      "Ему вовек веков",
      "Хвала принадлежит."
     ]
    }
   ]
  }
 ]
}