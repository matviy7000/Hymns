 "songs": [
  {
   "src": "p0039.png",
   "num": "41",
   "title": "Я познал в Твоем Писанье",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я познал в Твоем Писанье",
      "Вечной истины закон,",
      "И Твой дар благодеяний,",
      "Что Тобою я спасен."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Весь закон Твой свят и верен –",
      "Жизни правило земной,",
      "Я же – жалок и неверен,",
      "Грешник бедный пред Тобой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ты услышал вопль мой скорбный,",
      "Веру в сердце возродил,",
      "И Тобою я спасенный",
      "Жить с Тобой теперь решил."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Дай мне Твой закон священный",
      "В жизни верно исполнять,",
      "И союз с Тобой в общенье",
      "До дня смерти сохранять."
     ]
    }
   ]
  },
  {
   "src": "p0039.png",
   "num": "42",
   "title": "Открой мне очи, Боже мой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Открой мне очи, Боже мой,",
      "Чрез Духа Твоего;",
      "Увижу Твой Закон святой",
      "И чудеса его."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай мне уразуметь, Господь,",
      "Велений путь святых,",
      "И буду размышлять всегда",
      "О чудесах Твоих."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Закон из уст Твоих, мой Бог,",
      "Душе неоценим,",
      "Пусть груды золота дают –",
      "Я не расстанусь с ним."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Все помыслы людских умов",
      "Я в жизни не терплю,",
      "А Твой Закон для нас благой",
      "Всем сердцем я люблю."
     ]
    }
   ]
  },
  {
   "src": "p0040.png",
   "num": "43",
   "title": "Господь Закон Свой чудный",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь Закон Свой чудный",
      "Нам с неба даровал,",
      "И на скрижалях сердца",
      "Чрез Духа написал.",
      "Лишь тот народ Господень,",
      "Кто чтит Его Закон",
      "И в вере соблюдает,",
      "Тот будет Им спасен."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Закон Господень вечный",
      "Должны мы соблюдать",
      "И Заповеди Божьи",
      "С любовью исполнять."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В Законе неизменном",
      "Всю святость Бог явил",
      "И в десять слов священных",
      "Закон Свой заключил.",
      "Я – Бог твой, Бог единый,",
      "И не имей других –",
      "Звучит нам повеленье",
      "В начале слов святых."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Кумиров не имейте,",
      "Не поклоняйтесь им,",
      "И не клянитесь вовсе",
      "Вы именем Моим.",
      "И помни день субботний,",
      "Дабы святить его,",
      "И посвяти святой день",
      "Для Бога своего."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "И почитай в смиренье",
      "Отца и мать твою,",
      "И жизнь в сердцах у ближних",
      "Не убивай ничью.",
      "И не прелюбодействуй,",
      "И не кради, не лги,",
      "Не пожелай чужого –",
      "Вот весь Закон благий."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Любовь к людям и Богу",
      "Мы можем в том явить,",
      "Когда лишь будем верно",
      "Закон Его любить.",
      "Ведь на любви основан",
      "Закон Творца святой",
      "И дан для исполненья",
      "Нам в жизни сей земной."
     ]
    }
   ]
  },
  {
   "src": "p0041.png",
   "num": "44",
   "title": "Слушай! Ангельские хоры",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Слушай! Ангельские хоры",
      "Оглашают Вифлеем,",
      "И горят небес просторы",
      "Славой чудных Божьих дел."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Слава, слава Богу в вышних!",
      "Мир живущим на земле,",
      "И Отца благоволенье",
      "Человеческой семье."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Почему пришло в движенье",
      "Небо все и так блестит?",
      "Что за песнь пред всей Вселенной",
      "В голубой дали звучит?"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Это песнь о Божьем Сыне,",
      "В Вифлиеме Он рожден.",
      "И любовью Божьей ныне",
      "Для спасенья послан Он."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Люди грешные, придите,",
      "Славьте Бога вы в сердцах,",
      "И свой глас соедините",
      "С хором дивным в небесах."
     ]
    }
   ]
  },
  {
   "src": "p0042.png",
   "num": "45",
   "title": "Большая звезда на небе взошла",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Большая звезда на небе взошла,",
      "И радостный свет во тьму пролила;",
      "Она мудрецов с востока вела",
      "И к яслям их в Вифлеем привела."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "На небесах горит звезда,",
      "Для всех она там зажжена.",
      "Ведет тебя, ведет меня",
      "В греховной тьме звезда Христа."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Поверили мудрецы в ту звезду –",
      "Она приведет их ко Христу,",
      "Она им видна издалека,",
      "Христос – их светлая звезда."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пойдем за звездой, как шли мудрецы,",
      "Нас в чудный тот свет, Господь, веди,",
      "Веди нас из тьмы прямым путем",
      "В Твой вечный свет, в Отцовский дом."
     ]
    }
   ]
  },
  {
   "src": "p0043.png",
   "num": "46",
   "title": "Слушай, вся земля",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Слушай, вся земля, внимая",
      "Хору ангельских певцов!",
      "Мир наземный оглашая,",
      "Льется песнь к нам с облаков:",
      "\"Люди все, восторжествуйте",
      "И в восторге возликуйте, –",
      "Искупитель вам рожден,",
      "Иисусом наречен!\""
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Пусть отныне и до века",
      "Пронесется торжество:",
      "С плотью грешной человека",
      "Съединилось Божество.",
      "Нет греху над нами силы,",
      "Небо жизнь нам подарило",
      "Всей хвалы достоин Он,",
      "Искупитель нам рожден!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Все прославьте дружным пеньем,",
      "Восхвалите все уста",
      "Вифлеемское рожденье",
      "Искупителя Христа!",
      "Наш Творец и наш Господь",
      "Принял человека плоть,",
      "С Небом нас соединил.",
      "\"С нами Бог – Эммануил!\""
     ]
    }
   ]
  }
 ]
}