 "songs": [
  {
   "src": "p0044.png",
   "num": "47",
   "title": "Хвалу Иисусу я желаю",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Хвалу Иисусу я желаю",
      "От всей души моей воспеть,",
      "Любовь Его я ощущаю",
      "И жажду лик Его узреть."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О как Он кроток, добр и силен",
      "Был на земле между людей,",
      "Ко всем Он был любвеобилен",
      "Средь искушений и скорбей."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Но тем же самым остается",
      "Вовеки Он в любви святой,",
      "И нам жизнь вечная дается",
      "Его Божественной рукой."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "И с этой дивною любовью",
      "Он снова в славе к нам придет,",
      "В тот день Омывшему нас кровью",
      "Мой дух гимн славы воспоет."
     ]
    }
   ]
  },
  {
   "src": "p0045.png",
   "num": "48",
   "title": "Слепой, несчастный Вартимей",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Слепой, несчастный Вартимей",
      "Услышал от людей,",
      "Что скоро там вблизи его",
      "Великий врач пройдет.",
      "Он стал кричать: \"Давидов Сын,",
      "Помилуй Ты меня\",",
      "Пока услышал нежный зов:",
      "\"Иди, Он ждет тебя!\""
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Иди, Он ждет тебя,",
      "Иди, Он ждет тебя,"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Сын Божий смерть позорную",
      "За грешников принял,",
      "И жизнь Свою невинную",
      "Безропотно отдал.",
      "И на кресте в страданиях,",
      "Душой за нас скорбя,",
      "Взывал Он к миру грешному:",
      "\"Иди, Я жду тебя\"."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И ныне Божий глас звучит",
      "И призывает нас,",
      "Несчастных, бедных и больных,",
      "Страдальцев всех земных.",
      "Так ласково Он приглашает",
      "Грешных чад, любя;",
      "К тебе, к тебе взывает Он:",
      "\"Иди, Я жду тебя\"."
     ]
    }
   ]
  },
  {
   "src": "p0046.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Он снимет с сердца скорбь твою,",
      "Иди, Он ждет тебя."
     ]
    }
   ]
  },
  {
   "src": "p0046.png",
   "num": "49",
   "title": "Тихая ночь, дивная ночь",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Тихая ночь, дивная ночь.",
      "Мир земной сон сковал,",
      "В Вифлееме покой, тишина,",
      "Лишь не спит там святая чета.",
      "Чудный Младенец рожден."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Тихая ночь, дивная ночь.",
      "Лишь звезда в небесах",
      "Ярким светом над миром горит",
      "И живущим нам всем говорит:",
      "Свыше нас Бог посетил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Тихая ночь, дивная ночь",
      "Грешным всем принесла",
      "Радость вечную в мир от Отца,",
      "И восторгом горят все сердца, –",
      "Ныне Спаситель нам дан."
     ]
    }
   ]
  },
  {
   "src": "p0047.png",
   "num": "50",
   "title": "Однажды пришел ко Христу Никодим",
   "complete": false,
   "blocks": [
