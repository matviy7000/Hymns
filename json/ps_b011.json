   "blocks": [
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "Все друзья Его бежали;",
      "Он в руках уж злых людей;",
      "Агнца кроткого связали",
      "И вели на суд властей.",
      "Его ложно обвиняли,",
      "Крови жаждали они,",
      "Его били, оплевали,",
      "И кричат: \"Распни, распни!\""
     ]
    },
    {
     "label": "7 КУПЛЕТ",
     "lines": [
      "Так унижен был Спаситель,",
      "Чашу горькую испил;",
      "На кресте наш Искупитель",
      "Кровью с нас вину омыл.",
      "Но Воскресший с облаками",
      "Скоро к славе вновь придет,",
      "И всех с чистыми сердцами",
      "В горний мир к Себе возьмет."
     ]
    }
   ]
  },
  {
   "src": "p0054.png",
   "num": "57",
   "title": "Пойте, братья, песнь хваленья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Пойте, братья, песнь хваленья,",
      "Пойте благость вы Христа;",
      "По святому изволенью",
      "Искупил Он нас от зла."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Пойте, братья, гимн хваленья,",
      "Славьте в песнях вы Христа;",
      "Подвиг нашего спасенья",
      "Совершил Он на кресте."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Пригвожден Он был на древо,",
      "Был поруган, отвержен, –",
      "Славное, святое дело",
      "Для спасенья сделал Он."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "На кресте страдал Спаситель,",
      "От греха нас искупил,",
      "И, воскреснув, Избавитель",
      "Смертью смерть Он победил."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Будем же, собратья, верны,",
      "Станем Господу служить",
      "Всей душой, нелицемерно,",
      "Искренне Его любить."
     ]
    }
   ]
  },
  {
   "src": "p0055.png",
