 "songs": [
  {
   "src": "p0075.png",
   "num": "80",
   "title": "Великий день, великий час",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Великий день, великий час,",
      "Когда услышал я впервые,",
      "Что Бог меня от смерти спас,",
      "Простив грехи мои былые.",
      "Что кровь Спасителя Христа",
      "Мои пороки все омыла,",
      "Что у подножия креста",
      "И наша жизнь, и наша сила."
     ]
    }
   ]
  },
  {
   "src": "p0076.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Великий час, великий миг,",
      "Когда я, сердцем утомленный,",
      "К ногам Спасителя приник,",
      "С Творцом и небом примиренный.",
      "Забыв весь мир, я в этот час",
      "Рыдал рыданьем жгучей муки,",
      "И слезы капали из глаз",
      "На сжатые в молитве руки."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В тот час Спасителя любовь",
      "Во мне горела ярким светом,",
      "И я, воспрянув к жизни вновь,",
      "Вознес Ему любви обеты.",
      "Так счастлив был я без конца.",
      "Но ныне, Боже, что со мною?",
      "Поднять я не могу лица",
      "И снова тяжкой полн тоскою."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Где первая любовь моя?",
      "Где пламень сердца вдохновенный?",
      "О как устал, измучен я",
      "Душой и сердцем, Царь Вселенной!",
      "О неужель в душе моей",
      "Вновь не воскреснет миг прекрасный,",
      "И не спою любви Твоей",
      "С восторгом в сердце песни славной?"
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Вернись же снова, чудный день!",
      "И словом нежным примиренья",
      "Сгони с души и мрак, и тень,",
      "Христос мой, кровью искупленья!",
      "Чтоб мог я вновь, весь мир забыв,",
      "К Твоим ногам прильнуть главою",
      "И на могучий Твой призыв",
      "Ответить пламенной мольбою."
     ]
    }
   ]
  },
  {
   "src": "p0076.png",
   "num": "81",
   "title": "Сильный Эммануил",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Сильный Эммануил,",
      "Князь мира, жизни сил,",
      "Боже святой!",
      "Ничто я без Тебя,",
      "Услыши Ты меня,",
      "И защити всегда,",
      "Грехи омой!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Враг жизни пожелал",
      "Меня пленить себе –",
      "В сердце войти.",
      "Но ведь Христос – мой щит,",
      "Он от лукавств хранит,",
      "Тьма перед Ним бежит –",
      "Он свет дарит."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пребуду в жизни я",
      "Средь испытаний зла",
      "Верным всегда.",
      "Уж близок славный день,",
      "Исчезнет смерти тень,",
      "В жизнь я войду с Христом,",
      "Он – мой Господь."
     ]
    }
   ]
  },
  {
   "src": "p0077.png",
   "num": "82",
   "title": "Он знает все",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Он знает всё: когда скорбь со мной",
      "Глубже всяких слов и песней;",
      "И заботы гнет, когда сердце жмет,",
      "Когда труден путь и длинней."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О да, Он знает скорбь мою",
      "И сердцем чувствует всё,",
      "Он знает: раны мне жизнью даны,",
      "Спаситель знает всё."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он знает все: когда темен путь,",
      "В моем сердце тоска и страх;",
      "Солнца свет зайдет,",
      "Ночи мрак сойдет,",
      "Когда дух повержен во прах."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Он знает все: когда волей слаб,",
      "Искушенья сражен мечом;",
      "Раскаянья стон,",
      "В сердце скорби полн,",
      "Нет покоя, мира ни в чем."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Он знает все: когда злая смерть",
      "Сердце верное унесет",
      "И разлучит нас, –",
      "В этот страшный час",
      "Моя боль к Иисусу взойдет."
     ]
    }
   ]
  },
  {
   "src": "p0078.png",
   "num": "83",
   "title": "В руках Христа могучих",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В руках Христа могучих,",
      "Прильнув к Его груди,",
      "Я от волнений жгучих",
      "Храним в Его любви.",
      "Словами утешенья",
      "Зовет Спаситель мой:",
      "\"Оставь свои сомненья,",
      "Войди же в Мой покой\"."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В руках Христа бесстрашно",
      "Взираю я вперед,",
      "В борьбе с врагом опасным",
      "Он верный мой оплот.",
      "Вдали от мук, терзаний",
      "Сомненье не гнетет,",
      "Немного испытаний –",
      "И наш Господь придет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Христос – скала живая,",
      "Убежище для всех,",
      "И кровь Его святая",
      "Смывает тяжкий грех.",
      "В день славного явленья,",
      "Когда Господь придет,",
      "Тогда душа спасенье",
      "Навеки обретет."
     ]
    }
   ]
  },
  {
   "src": "p0079.png",
   "num": "84",
   "title": "Я знаю чудесное Имя",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я знаю чудесное Имя,",
      "Велико и славно Оно,",
      "Звучит так приятно, где правда,",
      "И грозно, где страсти и зло."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Да прославят Христа все народы,",
      "Это Имя повсюду звучит,",
      "Всех влечет к жизни светлой и новой",
      "И спасение нам дарит!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Нет равного Имени в мире,",
      "Нет в небе подобных Ему,",
      "Все страны Оно проникает,",
      "Рассеет пороки и тьму."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В том Имени – мир и свобода",
      "От власти греха и страстей,",
      "И в Нем лишь прямая дорога",
      "К небесной Отчизне моей."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Хвала, поклоненье и слава",
      "О дивное Имя, Тебе!",
      "Ты свет нам во тьме посылаешь,",
      "Любя, привлекаешь к Себе."
     ]
    }
   ]
  }
 ]
}