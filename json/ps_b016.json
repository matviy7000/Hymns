 "songs": [
  {
   "src": "p0080.png",
   "num": "85",
   "title": "Добрый Пастырь призывает",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Добрый Пастырь призывает",
      "К стаду верному прийти;",
      "И тебя Он приглашает",
      "По Его стопам идти."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он искал тебя всечасно,",
      "Днем и ночью охранял,",
      "И от гибели опасной",
      "Он тебя оберегал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Он зовет: \"Я дам спасенье,",
      "Я покой даю сердцам;",
      "И от смерти избавленье",
      "Я лишь всем послушным дам\"."
     ]
    }
   ]
  },
  {
   "src": "p0081.png",
   "num": "86",
   "title": "Господь нас всех к Себе влечет",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь нас всех к Себе влечет",
      "Своей рукой пронзенной,",
      "Любовь, покой и мир дает",
      "Душе обремененной."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Как нежен Он в любви Своей,",
      "Он Сам Отца молил о нас.",
      "Страдал за нас,",
      "Христос страдал за нас."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он слышит каждый вздох груди.",
      "Страдал Он, нас спасая;",
      "Теперь зовет: \"Ко Мне приди!\",",
      "Объятья раскрывая."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О как достойно оценить",
      "Его любовь святую?",
      "Его кровь вечно будем чтить,",
      "Для нас столь дорогую."
     ]
    }
   ]
  },
  {
   "src": "p0082.png",
   "num": "87",
   "title": "Славно имя Иисуса",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Славно имя Иисуса,",
      "Исцеленье в Нем для всех;",
      "Мир, покой вселяет в сердце,",
      "Побеждает всякий грех."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О, друзья, воспоем",
      "Гимн восторга перед Ним,",
      "И падем пред Христом,",
      "Честь и славу воздадим."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Именем Христа мы будем",
      "Путь наш узкий продолжать;",
      "Он – наш щит и наша крепость,",
      "С Ним мы можем побеждать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Дорого Христово имя, –",
      "Счастье, радость нам дает;",
      "От мирских сует греховных",
      "Сердце к небесам влечет."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Имя Иисуса славьте",
      "Все с восторженной хвалой;",
      "Скоро Он придет во славе",
      "И введет нас в край родной."
     ]
    }
   ]
  },
  {
   "src": "p0083.png",
   "num": "88",
   "title": "Где Бог в сердцах живет",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Где Бог в сердцах живет,",
      "Там радость без забот.",
      "Как дивно имя Иисуса!",
      "Средь искушенья, тьмы,",
      "Сомненья и борьбы",
      "Так дивно имя Иисуса!"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Прославленье, честь, хваленье;",
      "Как дивно имя Иисуса!",
      "Прославленье, честь, хваленье",
      "Навеки воспою."
     ]
    }
   ]
  },
  {
   "src": "p0084.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Как радостно звучит",
      "Та песнь с высот небес:",
      "\"Как дивно имя Иисуса!\"",
      "О друг мой, избери",
      "Господень путь чудес,",
      "Чтоб вечно быть вблизи Иисуса."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Оставь греховный путь,",
      "Всю суету греха,",
      "Служи всем сердцем Иисусу.",
      "Чтоб вечно отдохнуть",
      "Ты мог у ног Христа,",
      "Предайся в руки Иисуса."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Спасенья песнь звучит",
      "И вторят все уста:",
      "\"Как дивно имя Иисуса!\"",
      "Печаль пусть не томит,",
      "Оставь всю скорбь греха",
      "И славь с восторгом Иисуса."
     ]
    }
   ]
  },
  {
   "src": "p0084.png",
   "num": "89",
   "title": "Как дивно имя Иисус",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Как дивно имя \"Иисус\" –",
      "Вселяет в сердце радость;",
      "Я всей душой познать стремлюсь",
      "Любви той дивной сладость."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О, пусть по всей земле пройдет",
      "Та весть любви всесильной;",
      "И пусть прославит весь народ",
      "Сей дар любви обильной."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Пред этим именем святым",
      "Пусть гордый мир смирится,",
      "С восторженной хвалой пред Ним",
      "Вся тварь пусть преклонится."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Иного имени нигде",
      "Ты не найдешь в сей жизни;",
      "Спасенье только во Христе,",
      "Лишь Он введет в Отчизну."
     ]
    }
   ]
  }
 ]
