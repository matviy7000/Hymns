 "songs": [
  {
   "src": "p0090.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Нет, я не один; нет, нет, никогда!",
      "Спаситель мне обещает",
      "Быть вместе со мною всегда."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Враг против меня ополчает",
      "Свои легионы на бой,",
      "Но мне побеждать помогает",
      "Христос, Искупитель мой.",
      "Спаситель – мое упованье,",
      "Слова Его: \"да\" и \"аминь\".",
      "Я верю в Его обещанье:",
      "\"Не бойся, не будешь один!\""
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Когда здесь, в долине страданья,",
      "Я помощь себе не найду,",
      "Тогда все мое упованье",
      "На Господа возложу.",
      "Когда сатана угрожает",
      "Излить свою злобу над мной,",
      "Спаситель тогда ободряет:",
      "\"Не бойся, Я буду с тобой!\""
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Страдал, истекая Он кровью,",
      "Вину мою Он мне простил;",
      "К Себе Он влечет всех любовью,",
      "Спасенье мое свершил.",
      "Когда же в день оный Спаситель",
      "Во блеске со славой придет,",
      "В небесную Божью обитель",
      "Меня Он к Себе вознесет."
     ]
    }
   ]
  },
  {
   "src": "p0091.png",
   "num": "95",
   "title": "Господь – наш Вождь",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь наш Вождь, не сами,",
      "За Ним идем всегда",
      "Тернистыми путями",
      "От мира смерти, зла",
      "К пределам жизни новой,",
      "Где чудный, светлый край,",
      "К обители готовой,",
      "Где жизни вечной рай."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Спасенье, да, спасенье",
      "Дает Христова кровь;",
      "Всем грешным искупленье",
      "Несет Христа любовь.",
      "Из недр святого Слова",
      "Дает нам все познать,",
      "И нет пути иного",
      "Спасенье получать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Придите к Иисусу –",
      "Спасенье только в Нем,",
      "Спасет Он вашу душу",
      "В учении святом.",
      "Вам даст познанье правды",
      "Святых Заповедей;",
      "Избавит от неправды",
      "Любовию Своей."
     ]
    }
   ]
  },
  {
   "src": "p0091.png",
   "num": "96",
   "title": "Не найдешь нигде",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Не найдешь нигде",
      "Жизни здесь себе;",
      "Во Христе одном,",
      "Жизнь ведь только в Нем."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "По любви святой",
      "Он страдал за нас",
      "Телом и душой",
      "В тот предсмертный час."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Чтоб нас искупить",
      "От пороков злых,",
      "К жизни пробудить",
      "На путях земных."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "В вечный край святой",
      "Грешных провести,",
      "Где святой покой",
      "Жизни и любви."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Где не будет зной",
      "С высоты палить,",
      "В святости покой",
      "Сердцу мир дарит."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "И прохлады тень",
      "В зелени садов",
      "Будет ночь, как день,",
      "Радость и покров."
     ]
    },
    {
     "label": "7 КУПЛЕТ",
     "lines": [
      "Эту жизнь дарит",
      "Наш Господь благой",
      "Тем, кто поспешит",
      "Зов принять святой."
     ]
    }
   ]
  },
  {
   "src": "p0092.png",
   "num": "97",
   "title": "Сохрани от заблужденья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Сохрани от заблужденья",
      "Мысль и ум пытливый мой.",
      "Слов Твоих святых ученье",
      "Дай любить мне всей душой.",
      "О если б постичь мне сокровищ значенье,",
      "Найти мне жемчужину в слове спасенья!",
      "Жизнь вечная скрыта в сем слове святом,",
      "Прощенье для всех отягченных грехом."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Боже, Сам источник слова",
      "Нам открой: пусть свет он льет,",
      "Разуменье истин новых",
      "Пусть для нас он принесет.",
      "Ты ученикам дал слова откровенья,",
      "Восхитив их дух чудным светом спасенья,",
      "О, дай же мне, Боже, познания свет,",
      "Дай силы хранить мне Твой вечный завет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ныне здесь явился снова,",
      "Чтобы пред Тобой предстать",
      "И Твое святое Слово",
      "В песнопеньях прославлять.",
      "Учение слова я здесь постигаю",
      "И дивную Божию весть восхищаю,",
      "Доколе в жизнь вечную все мы войдем,",
      "В Сионе, там вечную радость найдем."
     ]
    }
   ]
  },
  {
