 "songs": [
  {
   "src": "p0095.png",
   "num": "101",
   "title": "Боже, здесь Твое мы стадо",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Боже, здесь Твое мы стадо,",
      "Пастырь добрый, к нам войди",
      "И на пажити отрады",
      "Нас, Твоих овец, веди.",
      "И на пажити отрады",
      "Нас, Твоих овец, веди."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Угнетенных, утружденных",
      "Нас с любовию прими",
      "И от недугов греховных,",
      "Врач великий, исцели.",
      "И от недугов греховных,",
      "Врач великий, исцели."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Призыв Твой любовью дышит,",
      "Свой народ благослови,",
      "Укрепи нас силой свыше,",
      "Дай нам дар святой любви.",
      "Укрепи нас силой свыше,",
      "Дай нам дар святой любви."
     ]
    }
   ]
  },
  {
   "src": "p0095.png",
   "num": "102",
   "title": "Отче наш, Твои мы дети",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Отче наш, Твои мы дети",
      "Вот собрались здесь опять;",
      "Дай Твое святое слово",
      "Нам услышать и принять,"
     ]
    }
   ]
  },
  {
   "src": "p0096.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Чтоб, живя в сем мире грешном,",
      "Нам Тебя лишь прославлять."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты Свой дождь благословений",
      "На детей излей Своих.",
      "Лепет наш и вопли сердца",
      "Ты услышь с высот Твоих.",
      "Дух Святой пошли обильно",
      "И введи в удел святых."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Помоги нам в искушенье",
      "Устоять и победить",
      "И закон священной воли",
      "С каждым днем сильней любить.",
      "О даруй Ты силу свыше,",
      "Чтоб послушными нам быть."
     ]
    }
   ]
  },
  {
   "src": "p0096.png",
   "num": "103",
   "title": "Отец людей, Отец Небесный",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Отец людей, Отец Небесный!",
      "Да имя вечное Твое",
      "Святится нашими сердцами;",
      "Да придет Царствие Твое!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Да будет воля Твоя с нами",
      "Как в небесах, так на земли,",
      "Твоей нам щедрою рукою",
      "Хлеб наш насущный ниспошли."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ты нас, ничтожных пред Тобою,",
      "Прости, Отец, Твоих детей,",
      "И дай нам искренней душою",
      "Прощать врагов и всех людей."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Не ввергни нас во искушенье,",
      "Когда настанет трудный час,",
      "Но от лукавого прельщенья",
      "Избави нас, избави нас!"
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Тебе да будет честь и слава,",
      "Земли и неба Властелин!",
      "Твое величье и держава –",
      "Во веки вечные. Аминь!"
     ]
    }
   ]
  },
  {
   "src": "p0097.png",
   "num": "104",
   "title": "О как рады мы собраться",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О как рады мы собраться,",
      "Боже наш, у ног Твоих.",
      "Слову жизни поучаться",
      "От Тебя из уст святых.",
      "Дай, чтоб ныне не напрасно",
      "Собрались мы здесь в тиши,",
      "Слов Твоих ученье ясно",
      "В наше сердце Ты впиши."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай, чтоб мы в Твоем ученье",
      "Правду вечную нашли;",
      "Весть благую о спасенье",
      "Жаждущей душе пошли.",
      "Время краткое сей жизни",
      "С пользой научи прожить,",
      "На пути к святой Отчизне",
      "Нас наставь Тебе служить."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О вложи в слова святые",
      "Силу, свет, огонь, любовь.",
      "Поучения благие",
      "Пусть подействуют в нас вновь.",
      "Помоги, чтоб мы приняли",
      "Слово, в сердце сохранив,",
      "Дай, чтоб многие узнали",
      "Истину из слов Твоих."
     ]
    }
   ]
  },
  {
   "src": "p0098.png",
   "num": "105",
   "title": "В долине греха я",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В долине греха я",
      "Устал, изнемог,",
      "Скорбя и страдая",
      "От зла и тревог.",
      "Мой взор помутился,",
      "Светильник погас,",
      "И дух утомился",
      "В борьбе каждый час."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И словно забыт я",
      "Тобой, о Христос,",
      "На сём поле битвы,",
      "Страданья и слёз.",
      "О, медлишь доколе?",
      "Ко мне поспеши!",
      "И в смертной юдоли",
      "Дай силу души."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В борьбе дай мне силы,",
      "Чтоб я не упал,",
      "Был твёрд до могилы,",
      "В пути не дремал.",
      "И узами тесно",
      "Любови святой",
      "Всегда, Бог небесный,",
      "Был связан с Тобой."
     ]
    }
   ]
  },
  {
   "src": "p0099.png",
   "num": "106",
   "title": "О пребудь средь нас, Спаситель",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О пребудь средь нас, Спаситель,",
      "Иисус, наш Искупитель!",
      "Пастырь добрый, нас паси.",
      "Ты нас всех благословляешь,",
      "Милосердье к нам являешь,",
      "О приди, нам мир неси!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О пребудь с благословеньем",
