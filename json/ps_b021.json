 "songs": [
  {
   "src": "p0105.png",
   "num": "114",
   "title": "Будь милосерд, о Боже мой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Будь милосерд, о Боже мой,",
      "Услыши вопль души больной,",
      "Дай искушенье победить",
      "И веру чистой сохранить."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Взгляни на скорбь мою теперь;",
      "Лукавый мне твердит: \"Не верь,",
      "Не верь Его святым словам, –",
      "В них не найдешь путь к небесам\"."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Тебя молю я, Боже мой,",
      "Даруй мне верою живой",
      "Грехи, пороки победить",
      "И истинным путем ходить."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Пока живу я в мире сем,",
      "Дай верным быть Тебе во всем,",
      "Твою святую волю чтить,",
      "Всю жизнь Тебе лишь посвятить."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Пошли мне силы, Боже мой,",
      "Исполнить Твой Закон святой;",
      "Молю, во мне дух обнови",
      "И укрепи в Твоей любви."
     ]
    }
   ]
  },
  {
   "src": "p0105.png",
   "num": "115",
   "title": "Пошли мне силы, Боже мой",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Пошли мне силы, Боже мой,",
      "Чтоб мог Тебе всегда служить,",
      "Чтоб жизни враг лукавый, злой",
      "Не мог меня здесь погубить."
     ]
    }
   ]
  },
  {
   "src": "p0106.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Пошли познанья полноту,",
      "Чтоб слову Твоему внимать,",
      "Чтоб в жизни сердца чистоту",
      "Я мог бы верно сохранять."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И радость сердцу, Боже мой,",
      "Даруй мне, я Тебя молю,",
      "Тогда с восторженной хвалой",
      "Прославлю благодать Твою."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Пошли терпенье мне в борьбе,",
      "Чтоб устоять и победить,",
      "И верным быть во всем Тебе,",
      "И заповедь Твою хранить."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Даруй мне сил на труд святой",
      "Для ближних и врагов моих,",
      "Пусть обратятся всей душой",
      "От пагубных путей своих."
     ]
    }
   ]
  },
  {
   "src": "p0106.png",
   "num": "116",
   "title": "Научи молиться",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Научи молиться,",
      "Бодрость в сердце влей;",
      "Помоги стремиться",
      "К святости Твоей.",
      "Мысли и желанья",
      "Привлеки к Себе,",
      "Веру, упованье",
      "Укрепи во мне."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай постичь душою",
      "Власть Твоей любви;",
      "Верою святою",
      "Дух мой оживи.",
      "Кротость и смиренье",
      "Дай, о Боже, мне,",
      "В скорби утешенье",
      "Дай иметь в Тебе."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пусть Твой дух поможет",
      "Слабости души;",
      "Пусть в уста мне вложит",
      "Он слова хвалы.",
      "И средь мук и боли",
      "Научи просить:",
      "Отче, Твою волю",
      "Помоги творить."
     ]
    }
   ]
  },
  {
   "src": "p0107.png",
   "num": "117",
   "title": "К Тебе, Господь, мой дух взывает",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "К Тебе, Господь, мой дух взывает,",
      "Услышь мой голос и внемли!",
      "Смотри: враг сети расставляет, –",
      "О не упасть мне помоги!",
      "Мой путь суров, – на небе тучи,",
      "Вихрь испытаний свыше сил;",
      "Склонись ко мне, о Бог могучий,",
      "Дабы врага я победил."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Как часто мучимый сомненьем",
      "Перед Тобой рыдаю я.",
      "О сжалься над моим мученьем,",
      "Прости, прости, мой Бог, меня.",
      "Отец благой, любвеобильный,",
      "Вершитель мира и судьбы,",
      "Творец всего, Господь всесильный,",
      "О, не отринь моей мольбы!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Скала Ты в мире развращенном,",
      "Утеха в трудный жизни час.",
      "Ты помощь, сила всем спасенным,",
      "Над нами бодрствует Твой глаз.",
      "Внемли ж мольбе моей и горе",
      "Не дай надежду потерять,",
      "Пребудь со мной в житейском море,",
      "Чтоб челн мой верно направлять."
     ]
    }
   ]
  },
  {
   "src": "p0108.png",
   "num": "118",
   "title": "Я люблю Тебя, Боже",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я люблю Тебя, Боже, люблю всей душой,",
      "Но в груди моей мало огня,",
      "Утомлен я смертельно неравной борьбой, –",
      "Одолела усталость меня."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Нет, нет, силы нет!",
      "Боже мой, я молю, укрепи Ты меня –",
      "Вся надежда моя на Тебя."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Нет уж силы во мне, нет стремленья к мольбе,",
      "Взор духовный туманится мой...",
      "И готов я упасть в непосильной борьбе,",
      "Если Дух не поможет мне Твой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И лукавый смущает и мучит меня,",
      "Хочет в сети свои затянуть;",
      "Но Ты, Боже, – скала и твердыня моя, –",
      "Ты не дай мне духовно уснуть."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ты зажги мое сердце священным огнем,",
      "Дай мне радость спасения вновь;",
      "Дай мне силу быть твердым и верным во всем,",
      "К моим ближним дай, Боже, любовь."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Научи меня волю Твою познавать,",
      "Чтить Закон Твой великий, святой.",
      "Научи меня, Боже, обиды прощать",
      "И друзьям, и врагам всей душой."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "И когда Ты придешь, чтоб судить этот мир,",
      "Мир коварный, развратный и злой,",
      "Помоги Ты, о Боже, на брачный тот пир",
      "Мне войти в Твой чертог золотой."
     ]
    }
   ]
  },
  {
