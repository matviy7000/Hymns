 "songs": [
  {
   "src": "p0110.png",
   "num": "120",
   "title": "Возьми меня за руки",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Возьми меня за руки",
      "И Сам веди",
      "Долиной скорби, муки",
      "В земном пути.",
      "Когда Ты Сам со мною,",
      "Спаситель мой, –",
      "Тернистою тропою",
      "Пойду с Тобой."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Твое благословенье",
      "Излей над мной;",
      "И от тревог, волнений",
      "Дай мне покой.",
      "К Тебе я прибегаю,",
      "Твое дитя,",
      "Тебе я доверяю,",
      "Веди меня."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Когда мне в жизни трудно",
      "И силы нет,",
      "Тогда сияет чудно",
      "Во тьме Твой свет.",
      "Возьми меня с Собою",
      "И Сам веди",
      "Здесь узкою стезею",
      "В земном пути."
     ]
    }
   ]
  },
  {
   "src": "p0111.png",
   "num": "121",
   "title": "Пребудь в нас с благодатью",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Пребудь в нас с благодатью,",
      "Спаситель наш Христос;",
      "Храни в Своих объятьях",
      "От вражьих злых угроз."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "С Твоим благословленьем,",
      "Спаситель, в нас пребудь",
      "И нам даруй с терпеньем",
      "Пройти тернистый путь."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И с верностью Твоею,",
      "Господь, пребудь средь нас",
      "И силою Своею",
      "Дай помощь в скорбный час."
     ]
    }
   ]
  },
  {
   "src": "p0111.png",
   "num": "122",
   "title": "О Господь, благодарим",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О Господь, благодарим",
      "За Твое святое Слово,",
      "Что насытил нас Ты им,",
      "Наставлял, учил так много.",
      "Все мы в радости святой",
      "Воспеваем, Бог благой."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О Христос, мы и Тебя",
      "Славим здесь за Весть Благую,",
      "И за то, что нас любя,",
      "Радость дал Ты нам святую.",
      "Дверь Ты слуха нам открыл",
      "И среди нас Духом был."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ты нас Словом вразумил,",
      "Как нам жить в земной юдоли,",
      "Покоряться научил",
      "Неизменной Отчей воле.",
      "Дай, чтоб свет тот не погас,",
      "Что зажег Ты, Боже, в нас."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Всех нас с миром распусти",
      "И с Твоим благословеньем",
      "Помоги нам обрести",
      "Сердцу радость, утешенье.",
      "Просим, Боже, в этот час",
      "Укрепи Ты веру в нас."
     ]
    }
   ]
  },
  {
   "src": "p0112.png",
   "num": "123",
   "title": "Иисус среди скорбей",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Иисус среди скорбей",
      "Лучший друг души моей.",
      "Сердцу мир я нахожу,",
      "Как к Христу я прихожу.",
      "И прими меня к Себе;",
      "Я ведь слаб в земной борьбе."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Иисус, Спаситель мой,",
      "Грех с души моей омой."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В дни стремлений суетных",
      "И превратностей земных",
      "Сохрани меня от зла",
      "И веди стезей добра.",
      "Дал услышать Ты мне вновь",
      "Про Твою, Господь, любовь;",
      "Милосердие яви",
      "И нас всех благослови."
     ]
    }
   ]
  },
  {
   "src": "p0112.png",
   "num": "124",
   "title": "О, слава в вышних Богу",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О слава в вышних Богу",
      "За этот час,",
      "В который Он так много",
      "Учил здесь нас!",
      "И Бог всесильным Духом",
      "Среди нас был,",
      "И ангелом могучим",
      "Всех охранил."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Господь, Своим Ты словом",
      "Мир сотворил",
      "И нас сегодня снова",
      "Им оживил.",
      "Теперь с благословеньем",
      "Нас распусти,",
      "И нам даруй терпенье",
      "В земном пути."
     ]
    }
   ]
  },
  {
   "src": "p0113.png",
   "num": "125",
   "title": "Да будет Тебе",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Да будет Тебе, наш Отец всеблагой,",
      "Вовек прославленье предвечной хвалой!"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Аллилуйя, будь прославлен,",
      "Аллилуйя, аминь!",
      "Аллилуйя, честь и славу",
      "Тебе воздадим!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Спаситель, прими поклоненье от нас;",
      "Ты всесильной любовью от смерти нас спас."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Честь, славу Творцу вознесем за любовь,",
      "Мы прославим хваленьем во веки веков."
     ]
    }
   ]
  },
  {
   "src": "p0114.png",
   "num": "126",
   "title": "За все Тебя, Господь, благодарю я",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "За все Тебя, Господь, благодарю я:",
      "За испытанья, трудности в пути,",
      "За слезы, радость, скорби и страданья,",
      "За все, за все, что мне даруешь Ты."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Благодарю Тебя за утешенья,",
      "Что Ты так часто мне в любви давал,",
      "Благодарю за горькие лишенья,",
      "Что в испытанье Ты мне посылал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Благодарю за свет в земной пустыне,",
      "Которым Ты светил с высот Твоих,",
      "За радость всю и милости доныне,",
      "Что Ты дарил мне в горестях земных."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "За все, за все Тебя благодарю я:",
      "За жизнь Твою, за пролитую кровь,",
      "За тяжкий крест, благие поученья,",
      "За смерть Твою и за Твою любовь."
     ]
    }
   ]
  }
 ]
