 "songs": [
  {
   "src": "p0124.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Бог льет в сердца."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он верной памятью стоит вовек",
      "Премудрого творения земли,",
      "И, соблюдая день сей, человек",
      "Постигнет дар Божественной любви."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Знаменьем день сей в мире должен быть",
      "Народа, чтущего Закон Христов,",
      "Того народа, кто Творцу служить",
      "Всем сердцем и умом всегда готов."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Пусть славный мир здесь многие сердца",
      "Введет под стяг знамения Христа,",
      "Чтобы творенье помнило Творца",
      "И славу Вышнему несли уста."
     ]
    }
   ]
  },
  {
   "src": "p0124.png",
   "num": "136",
   "title": "Суббота, данная нам Богом",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Суббота, данная нам Богом,",
      "Идет вновь с радостью святой;",
      "Покоем может наслаждаться,",
      "Кто страждет телом и душой.",
      "О Боже, нас благослови",
      "И дух усталый оживи."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Душа полна отрады, счастья,",
      "Сегодня Бог наш близок к нам.",
      "И чудо милости, спасенья",
      "Узреть Он даст моим очам;",
      "И хлебом жизни насытит,",
      "Обильно нас благословит."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Смотрю на звезды в темном небе,",
      "Слежу, как облако плывет,",
      "Гляжу на жизнь в морях – и в сердце",
      "Благодарение растет;",
      "И открываются уста,",
      "Чтобы воспеть любовь Христа."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Твое творение ликует,",
      "И нет того, кто бы молчал.",
      "Поют Тебе все те, которых",
      "Ты в день седьмой благословлял.",
      "И ныне здесь перед Тобой",
      "Тебя мы славим всей душой."
     ]
    }
   ]
  },
  {
   "src": "p0125.png",
   "num": "137",
   "title": "Как сладок день святой",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Как сладок день святой для нас,",
      "И как отраден сердцу час,",
      "Когда приходим в Божий дом",
      "И песнь хвалы поем."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О как чуден день святой,",
      "И как сладок тот покой,",
      "Когда приходим в Божий дом",
      "И песнь хвалы поем!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Господь сердца нам просветил",
      "И ввел в покой, благословил.",
      "Воспойте все хвалу Творцу,",
      "Небесному Отцу!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Нет сладостнее ничего,",
      "Как славить Бога своего,",
      "В святой день петь Ему псалом,",
      "Придя в Господний дом."
     ]
    }
   ]
  },
  {
   "src": "p0126.png",
   "num": "138",
   "title": "От сна проснувшись рано",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "От сна проснувшись рано,",
      "Мой дух Творцу поет.",
      "Сегодня день Господний,",
      "Покой от всех забот.",
      "Все братья, сестры тоже,",
      "Проснувшись, от души",
      "Поют Тебе, о Боже,",
      "Ты – Страж в ночной тиши."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Исполнен Твоей веры,",
      "Я, как Твое дитя,",
      "Молю, стучась у двери:",
      "Услышь, Господь, меня.",
      "Хочу я и сегодня",
      "Служить, мой Бог, Тебе,",
      "И пред Тобой угодным",
      "Ходить дай, Боже, мне."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В Твоих руках всесильных",
      "Сей день, а с ним и я;",
      "Луч радости обильной",
      "Излей, Господь, в меня.",
      "И если путь страданий",
      "Ты мне предусмотрел,",
      "Так дай, чтоб без роптаний",
      "Я шел и не скорбел."
     ]
    }
   ]
  },
  {
   "src": "p0126.png",
   "num": "139",
   "title": "Боже, пред лицом Твоим",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Боже, пред лицом Твоим",
      "В день святой, благословенный",
      "Пред Тобой в мольбе стоим,",
      "О, услышь наш глас смиренный!",
      "Мы хвалу Тебе возносим,",
      "Славословия приносим."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай, чтоб слово в сердце мне",
      "Силой свыше углубилось;",
      "Добродетель в тишине",
      "В жизни нашей проявилась.",
      "Истины заря пусть рдеет,",
      "Заблужденья тьму рассеет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Волю дай Твою творить",
      "Сердцем, всей душою вечно;",
      "Научи Тебя любить,",
      "Мой Спаситель, бесконечно,",
      "Чтоб средь горя и страданья",
      "Не терять нам упованья."
     ]
    }
   ]
  }
 ]
}