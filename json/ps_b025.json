 "songs": [
  {
   "src": "p0127.png",
   "num": "140",
   "title": "От сна восстав",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "От сна восстав, в сей день святой",
      "Тебя, Отец, благодарим,",
      "Благоговейно пред Тобой",
      "С смиренным сердцем предстоим."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты ночью всех нас охранял",
      "Под сенью ангелов от зла",
      "И в дом молитвы нас собрал,",
      "Когда заря небес взошла."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ты, Отче, нас благослови,",
      "Дай помощь нам в святом труде.",
      "И в сей день мира и любви",
      "Дай быть с Тобой всегда, везде."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Свой Дух Святой на нас излей,",
      "Чтоб нам всем сердцем и душой,",
      "Забыв ярмо земных скорбей,",
      "Тебя прославить в день святой."
     ]
    }
   ]
  },
  {
   "src": "p0127.png",
   "num": "141",
   "title": "День святой, ты – радость мне!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "День святой, ты – радость мне!",
      "Ты несешь покой земле,",
      "Отдых после дней труда,",
      "Дар небесный для меня."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Память рая ты для всех,",
      "Нас изгнал оттуда грех.",
      "Сладость ты вкусить даешь",
      "Той Отчизны, где нет слез."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Всех печальных утешай,",
      "Божье стадо собирай,",
      "Сына блудного зови,",
      "Иго с грешника сними."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ныне всем, живущим здесь,",
      "Принеси привет с небес;",
      "Весть спасенья влей в сердца,",
      "И прославим мы Отца."
     ]
    }
   ]
  },
  {
