 "songs": [
  {
   "src": "p0132.png",
   "num": "148",
   "title": "Воспряньте от забот",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Воспряньте от забот дней будних,",
      "Утихнет пусть работы пыл,",
      "Сегодня хлеб небесный, чудный",
      "Господь во храме преломил."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Ему обеты уплатите,",
      "Прославьте Божью славу, честь,",
      "В молитвах сердце вознесите,",
      "Спешите жертву уст принесть."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Тебе, Спаситель, сердце ценно, –",
      "Ты в нем алтарь Себе воздвиг;",
      "Дай Твой Закон, для нас священный,",
      "Нам помнить каждый час и миг."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Мы, Боже, здесь стоим, внимаем,",
      "О, Духом нас влеки к Себе!",
      "Мы на Тебя лишь уповаем,",
      "И мир имеем лишь в Тебе."
     ]
    }
   ]
  },
  {
   "src": "p0133.png",
   "num": "149",
   "title": "Всю неделю",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Всю неделю десница Господня",
      "Нас вела в этой жизни земной;",
      "Он хранил нас, и вот мы сегодня",
      "Вновь имеем и мир, и покой."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Дни забот о насущном промчались,",
      "В этот день они нам далеки,",
      "Мы Иисуса прославить собрались,",
      "Наши мысли светлы и легки."
     ]
    }
   ]
  },
  {
   "src": "p0134.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И в субботний покой – ликованье!",
      "Полны пением наши уста;",
      "Мы склоняемся, Божьи созданья,",
      "У подножья Христова креста."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Славим Бога за кровь искупленья,",
      "За великую жертву Его,",
      "За бесценный дар – жизнь и спасенье –",
      "Славим, славим Творца своего."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "И Божественной истины Слово",
      "Растворяется верой в сердцах, –",
      "Вновь до смерти страдать мы готовы",
      "За Владыку Христа в небесах."
     ]
    }
   ]
  },
  {
   "src": "p0134.png",
   "num": "150",
   "title": "С радостным чувством встречаем",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "С радостным чувством встречаем мы вновь день субботний!",
      "Он нам дороже всех дней, день от забот свободный!",
      "Радостно нам, Богом спасенным сердцам.",
      "Славен святой день Господний!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Вместе собравшись здесь в малом числе в день прекрасный,",
      "Славим Творца, нам давшего покой благодатный.",
      "День от Отца будем мы чтить без конца,",
      "Данный покой нам отрадный."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "День сей начертан в Законе для всего Творенья,",
      "Верным рабам он – знамя и знак запечатленья.",
      "Божий народ чтит субботу в род и род",
      "С радостным чувством хваленья."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Кто весь закон исполнит, тот на Кристальном море",
      "Победный гимн споет для Агнца в небесном хоре.",
      "Малый народ, с Божьим знаменем вперед!",
      "Там мы забудем все горе."
     ]
    }
   ]
  },
  {
