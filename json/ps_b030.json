 "songs": [
  {
   "src": "p0156.png",
   "num": "172",
   "title": "Святой день Господень",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Святой день Господень – небесный покой,",
      "Он радость приносит усталым душой;",
      "Его приближенье вселяет во мне",
      "Блаженство и счастье в святой тишине."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Слава, слава!",
      "Славу вовек",
      "За день сей святой да воздаст человек."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Я чувствую: тесно мне в келье моей,",
      "Стремлюсь в дом Господень средь Божьих детей;",
      "Здесь вместе гимн славы поем с торжеством,",
      "Творца прославляем, моленья несем."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Царь мира сегодня нам Вестника шлет,",
      "Нас грешных к Спасителю всех Он зовет;",
      "Дух Божий здесь веет, в сердцах жизнь творит,",
      "И мир Свой небесный Спаситель дарит."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "В субботу мы здесь предвкушаем покой,",
      "В который введет нас Отец всеблагой.",
      "И в день, когда в славный покой тот войдем,",
      "Там вечно Христу песнь хвалы воспоем."
     ]
    }
   ]
  },
  {
   "src": "p0157.png",
   "num": "173",
   "title": "Прекрасный день Господний",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Прекрасный день Господний,",
      "Святой покой субботний,",
      "Прошел и ночь вблизи.",
      "Все помыслы, стремленья –",
      "Тебе воздать хваленье",
      "За все дары Твоей любви."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Блеск Божьего престола,",
      "Весть вечного глагола,",
      "За Дух Святой с небес,",
      "Что разум постигает,",
      "Что сердце наполняет,",
      "За все, за все хвала Тебе!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пусть этот луч небесный,",
      "Сей дивный свет чудесный,",
      "На пользу светит нам.",
      "Где тьма все покрывает,",
      "Где человек страдает,",
      "Свой тихий свет лей в сердце нам."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Излей Свой свет над мною,",
      "Когда ночной порою",
      "Глаза сомкнутся сном;",
      "В тиши глубокой ночи,",
      "Когда смыкаем очи,",
      "Ты, Боже, бодрствуешь над мной."
     ]
    }
   ]
  },
  {
   "src": "p0158.png",
   "num": "174",
   "title": "Ближе, мой Бог, к Тебе",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе!",
      "Стремлюсь всем сердцем я",
      "И всей душой.",
      "Хоть труден путь земной,",
      "Но я прошу в мольбе:",
      "Дай ближе быть к Тебе,",
      "Ближе к Тебе!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе.",
      "Не виден путь во мгле,",
      "В греховной мгле;",
      "Ты светом озари",
      "И силой одари.",
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе.",
      "О помоги в борьбе,",
      "В земной борьбе;",
      "Дай узкий путь пройти",
      "И мир в Тебе найти,",
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе.",
      "О кто бы на земле",
      "Крылья дал мне?",
      "Я б улетел туда,",
      "Где нет скорбей труда,",
      "Ближе, мой Бог, к Тебе,",
      "Ближе к Тебе."
     ]
    }
   ]
  },
  {
