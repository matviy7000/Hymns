 "songs": [
  {
   "src": "p0175.png",
   "num": "191",
   "title": "Если путь твой мрачный",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Если путь твой мрачный, темный,",
      "И нависли облака,",
      "Бурь не бойся, над тобою",
      "Божья сильная рука.",
      "Верь Ему, Он власть имеет,",
      "Буря перед Ним молчит;",
      "Властно Он грозу смиряет,",
      "От беды тебя хранит."
     ]
    }
   ]
  },
  {
   "src": "p0176.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Верь Ему – спасенье Он дает;",
      "Верь Ему – хранит Он Свой народ;",
      "Верь Ему – Он твердый твой оплот;",
      "Верным пребывай и верь, верь Ему."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Если ты теряешь силы,",
      "Изнемог в земной борьбе,",
      "Верь, надейся, твой Спаситель",
      "Бодрость, силы даст тебе.",
      "Верь Ему, хоть все объято",
      "Беспросветной, мрачной тьмой,",
      "Верный страж не дремлет ночью,",
      "Бдит во тьме Он над тобой."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Если горе и заботы",
      "Угнетают твой покой –",
      "Обратись к Тому, Кто может",
      "Облегчить твой путь земной.",
      "Дар святой – Дух благодати.",
      "В помощь Бог тебе пошлет,",
      "Свет небесный лучезарный",
      "Он во тьму невзгод прольет."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Верь Ему, Творцу Вселенной,",
      "Хоть и узок здесь твой путь,",
      "Твердо стой средь искушений,",
      "Верным до конца пребудь.",
      "\"С вами во все дни Я буду!\" –",
      "Обещал Спаситель нам.",
      "Уповай, надейся твердо,",
      "Верь Его святым словам!"
     ]
    }
   ]
  },
  {
   "src": "p0177.png",
   "num": "192",
   "title": "Верь так просто, как дитя",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Верь так просто, как дитя,",
      "Вера пусть хранит тебя.",
      "Среди бури и невзгод",
      "\"Веруй\", – глас Христа зовет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Верить буду, Боже мой,",
      "Верить твердо всей душой.",
      "Зов Твой бодрость мне дает,",
      "\"Веруй\", – голос Твой зовет."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Льешь Ты в мой сосуд пустой",
      "Дар небесный – Дух Святой;",
      "Помощь мне Он подает –",
      "\"Веруй\", – голос Твой зовет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Радуюсь я в ясный день",
      "И молюсь, как ляжет тень.",
      "Чужд я страха и забот –",
      "\"Веруй\", – голос Твой зовет."
     ]
    }
   ]
  },
  {
   "src": "p0177.png",
   "num": "193",
   "title": "О вера Божия, святая",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О вера Божия, святая!",
      "Ты – дар Всевышнего Творца;",
      "Из Слова Божья истекая,",
      "Ты укрепляешь нам сердца,"
     ]
    }
   ]
  },
  {
   "src": "p0178.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Ты к совершенству нас ведешь,",
      "И упованье нам даешь."
     ],
     "join_previous": true
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И во Христе ты обитала,",
      "О вера Божия, всегда,",
      "Его в пути сопровождала",
      "Под тяжкой ношею креста –",
      "Победу ты Ему дала",
      "Над властью смерти и греха."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И нам помочь Ты обещаешь",
      "В сем мире похотей и зла,",
      "И путь нам в вечность освещаешь",
      "В долине мрака и греха.",
      "Хвала Тебе, Отец благой,",
      "За чудный веры дар святой."
     ]
    }
   ]
  },
  {
   "src": "p0178.png",
   "num": "194",
   "title": "Верить",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Верить – это, познавая",
      "Волю Божью, в ней пребыть,",
      "Мир порочный оставляя,",
      "Со Христом в союзе жить."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Верить – это милосердья",
      "Жаждать, если грех свершен,",
      "Чтоб в крови Владыки жизни",
      "Был тот грех навек прощен."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Верить – это доверяться",
      "Богу сердцем всем своим,",
      "Никогда не сомневаться,",
      "Что я Господом любим."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Верить – это с упованьем",
      "Исполненья ожидать",
      "Верных слов обетованья,",
      "Что Христос придет опять."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Верить – это без сомнений",
      "Слово Божье все принять,",
      "И Господни повеленья",
      "В жизни здесь осуществлять."
     ]
    }
   ]
  },
  {
   "src": "p0179.png",
   "num": "195",
   "title": "Вера есть сила народа",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Вера есть сила народа,",
      "Бог ее в сердце дарит,",
      "Радость, любовь и свобода",
      "В действиях веры царит."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Верой живою",
      "В мире сем узкой тропою",
      "К небу мы верно дойдем,",
      "Вечную жизнь обретем."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Вера есть щит, огражденье,",
      "С нею мы бодро идем,",
      "С верой в житейском сраженье",
      "Мы никогда не падем."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пусть нас враги окружают,",
      "Выступив все, как один,",
      "Смертию пусть угрожают –",
      "Верой мы их победим."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Пусть затрудненье горою",
      "Станет пред нами в пути,",
      "Братья, мы верой живою",
      "Сможем преграду смести."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Пусть нас все люди позорят,",
      "В мире развратном клеймят,",
      "Веры нам светлые взоры",
      "Будущность все ж не затмят."
     ]
    }
   ]
  }
 ]
}