   "title": "Людям волей всеблагою",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Людям волей всеблагою",
      "Сила дивная дана:",
      "Верой кроткою, святою",
      "Эта сила названа."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Людям волей всеблагою",
      "Сила дивная дана:",
