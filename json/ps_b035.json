 "songs": [
  {
   "src": "p0185.png",
   "num": "201",
   "title": "Посмотри, вот дом высоко",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Посмотри, вот дом высоко",
      "Вверх поднявши купол свой,",
      "Смотрит с гордостью далеко",
      "Над шумящею рекой.",
      "Но смотрите это зданье",
      "Не разумной плод руки,",
      "В нем не камень – основанье,",
      "А песчаный брег реки."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Вот подули ветры с силой,",
      "Дождь по стенам дом хлестал,",
      "Основанье все подмыло –",
      "И высокий дом упал.",
      "В стороне ютясь убого,",
      "На граните крепких скал,",
      "Не в сиянии чертога",
      "Скромно дом другой стоял."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Но воздвигнул это зданье",
      "Мудрый в жизни человек,",
      "Для устоев основанья",
      "Он избрал скалистый брег.",
      "Дождь пошел, разлились реки,",
      "Ветер на дом налегал,",
      "Но не рухнет он вовеки:",
      "Он стоит на камне скал."
     ]
    }
   ]
  },
  {
   "src": "p0186.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Так на каменной основе",
      "Будет жизнь и тех людей,",
      "Кто на вечном Божьем Слове",
      "Строит веры дом своей;",
      "Строит веру в послушанье",
      "Воле Господа святой",
      "И Закон весь неизменно",
      "Соблюдает всей душой."
     ]
    }
   ]
  },
  {
   "src": "p0186.png",
   "num": "202",
   "title": "Не унывай, когда тернист твой путь",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Не унывай, когда тернист твой путь,",
      "Когда устал и хочешь отдохнуть,",
      "Когда страдаешь, на Христа взирай!",
      "Мой друг, не унывай!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Не унывай, когда в груди твоей",
      "Угаснет луч надежды прежних дней,",
      "Борись, мой друг, и к Господу взывай!",
      "Мой друг, не унывай!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Не унывай, когда враги вокруг",
      "И редким стал друзей любимых круг,",
      "Гони печаль! На Бога уповай!",
      "Мой друг, не унывай!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Не унывай, когда густеет мгла",
      "И грудь тоска змеею облегла, –",
      "Христос всегда с тобой, о смертный, знай!",
      "Мой друг, не унывай!"
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Не унывай, пусть враг теснит порой,",
      "Пусть искушает прелестью земной,",
      "Пусть в мир зовет – ему ты не внимай!",
      "Мой друг, не унывай!"
     ]
    }
   ]
  },
  {
   "src": "p0187.png",
   "num": "203",
   "title": "В житейском челне",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В житейском челне по волнам я несусь.",
      "С утра до заката тружусь и молюсь,",
      "Хоть тени ночные нависли над мной, –",
      "Смелей, отдохну я за бурной рекой!"
     ]
    }
   ]
  },
  {
   "src": "p0188.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Хоть к ночи склонится мой сумрачный день",
      "И труд мой сокроет полночная тень,",
      "Последний луч света блеснет надо мной, –",
      "Смелей, отдохну я за бурной рекой!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Хоть меркнет порою надежды звезда,",
      "Душа истомится, устанет рука,",
      "И бурные волны грозят мне порой, –",
      "Смелей, отдохну я за бурной рекой!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Я к берегу правлю надежды ладью,",
      "Житейские волны качают ее,",
      "Но берег уж близок, Спаситель там мой, –",
      "Смелей, отдохну я за бурной рекой!"
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "У ног Иисуса я бремя сложу,",
      "От штормов земных там навек отдохну,",
      "Вот двери Отчизны открыты пред мной, –",
      "Смелей, отдохну я за бурной рекой!"
     ]
    }
   ]
  },
  {
   "src": "p0188.png",
   "num": "204",
   "title": "Весть отрады",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Весть отрады, Весть Благая",
      "Нам несет надежды луч,",
      "Светом правды озаряя,",
      "Светит нам сквозь сумрак туч."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Хоть порою станет трудно",
      "Нам за истину стоять,",
      "В это время всем нам нужно",
      "С просьбой к Богу прибегать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Бог поможет нам избегнуть",
      "Всех напастей от врага;",
      "С верой лишь должны прибегнуть:",
      "Нам победа дорога!"
     ]
    }
   ]
  },
  {
   "src": "p0189.png",
   "num": "205",
   "title": "Просите, и дано вам будет",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "\"Просите, и дано вам будет\" –",
      "Когда-то Спаситель учил;",
      "Просите, Бог с вами пребудет",
      "И даст вам терпенья и сил.",
      "Просите же Духа Святого",
      "И твердости в вашем пути,",
      "Познания Божьего"
     ]
    }
   ]
  },
  {
   "src": "p0190.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Слова,",
      "Чтоб верной дорогой идти."
     ],
     "join_previous": true
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ищите, друзья, и найдете",
      "Жемчужину веры живой,",
      "В ней мир и покой обретете",
      "И радости в жизни земной.",
      "Ищите ж без устали, братья,",
      "Вы царство и правды Творца;",
      "Он дать вам готов без изъятья",
      "И счастье, и жизнь без конца."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Стучите сильней и отворит",
      "Вам дверь милосердья Христос,",
      "Все ваши пороки покроет,",
      "Сотрет с глаз следы ваших слез.",
      "Стучите ж, упорно стучите!",
      "Он благ, наш Господь, без конца,",
      "Его всей душой восхвалите,",
      "Ликуя во славу Творца."
     ]
    }
   ]
  },
  {
   "src": "p0190.png",
   "num": "206",
   "title": "Жизнь часто мрачна, сера",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Жизнь часто мрачна, сера",
      "И, кажется, в груди",
      "Так пусто, нет в нас веры,",
      "Нет искорки любви.",
      "И, кажется, спасенья",
      "Достичь так трудно нам;",
      "Бывают все ж мгновенья,",
      "Когда Бог близок к нам."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Верным Богу пребудь,",
      "Облегчит Он твой путь,",
      "Превратит Он скорбь в восторг,",
      "Будет все, как хочет Бог."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Господь Сам избирает,",
      "Когда нам счастье дать,",
      "Он нашу скорбь смиряет,",
      "Дает нам благодать.",
      "Блаженства дождь чудесный",
      "Он в наше сердце льет",
      "И яркий свет небесный",
      "На темный путь наш шлет."
     ]
    }
   ]
  },
  {
   "src": "p0191.png",
   "num": "207",
   "title": "Если крест тяжел порою",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Если крест тяжел порою, –",
      "Глянь с верой вверх!",
      "Не робей, Христос с тобою, –",
      "Глянь с верой вверх!"
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О неси свой крест с терпеньем, –",
      "Глянь с верой вверх!",
      "Дух Святой даст утешенье, –",
      "Глянь с верой вверх!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Если бой начать опасно, –",
      "Глянь с верой вверх!",
      "Со Христом ничто не страшно, –",
      "Глянь с верой вверх!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Хоть в борьбе ты и слабеешь, –",
      "Глянь с верой вверх!",
      "С Богом все ты одолеешь, –",
      "Глянь с верой вверх!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Если скорбь и угнетает, –",
      "Глянь с верой вверх!",
      "Скоро помощь поспешает, –",
      "Глянь с верой вверх!"
     ]
    }
   ]
  },
  {
   "src": "p0192.png",
   "num": "208",
   "title": "И холод, и вьюга, и зной",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "И холод, и вьюга, и зной",
      "Здесь в мире превратном всегда,",
      "Нам скорби жмут сердце порой,",
      "Когда мы, когда мы, когда мы, когда мы",
