 "songs": [
  {
   "src": "p0228.png",
   "num": "242",
   "title": "Я хочу, мой Спаситель, любить",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я хочу, мой Спаситель, любить",
      "Тебя всею душою всегда,",
      "Я хочу никогда не забыть,",
      "Как Ты плакал, страдал за меня."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты спасенье ведь даром даешь,",
      "И я рад, что меня Ты купил,",
      "Но как-будто Ты все вопиешь",
      "На кресте: \"Отче, всем ли простил?\""
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О дай помнить, как трудно было",
      "На кресте Тебе нас искупить,",
      "Хочу в жизни иметь лишь одно:",
      "Тебя сердцем всецело любить."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Хочу жить всей душой для Тебя,",
      "Твой Закон свято в жизни блюсти,",
      "Хочу всем возвестить, как любя",
      "Восхотел Ты всех грешных спасти."
     ]
    }
   ]
  },
  {
   "src": "p0229.png",
   "num": "243",
   "title": "Господь, Тебя люблю",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь, Тебя люблю",
      "И песнь Тебе пою;",
      "О Боже мой, молю:",
      "\"Услышь меня!",
      "Дай дар Твоей любви,",
      "Ты милость мне яви,",
      "Дух сердца обнови:",
      "Ведь грешен я\"."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Господь, приди ко мне,",
      "Ты – мощь моя!",
      "О помоги в борьбе.",
      "Я жду Тебя."
     ]
    }
   ]
  },
  {
   "src": "p0230.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай свято жизнь прожить,",
      "От сердца всех любить,",
      "Грехи все победить.",
      "Господь, с Тобой.",
      "О Боже, слаб я стал,",
      "Свой крест нести устал,",
      "И чтоб я не упал, –",
      "Пребудь со мной."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Услышь мой вопль земной,",
      "Прошу Тебя с мольбой:",
      "Дай жертвовать собой",
      "В делах святых.",
      "Все, чем я дорожу,",
      "Тебе я приношу",
      "Как жертву, все сложу",
      "У ног Твоих."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Господь, пребудь со мной",
      "Здесь в страшной тьме земной,",
      "Чтоб мне идти тропой",
      "В град золотой.",
      "Пусть грозный враг страшит",
      "И зло кругом кипит, –",
      "Ты – верный, крепкий щит –",
      "Всегда со мной!"
     ]
    }
   ]
  },
  {
