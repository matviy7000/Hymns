 "songs": [
  {
   "src": "p0238.png",
   "num": "252",
   "title": "Слышите ль Господень призыв?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Слышите ль Господень призыв:",
      "\"Кто Христу служить готов?\"",
      "Жатвы много созревает,",
      "Жатва делателей ждет.",
      "Бог награду обещает,",
      "Громко всех зовет к Себе;",
      "Кто откликнется, кто скажет:",
      "\"Я готов служить Тебе!\"?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты не можешь мир объехать",
      "Как Христов миссионер,",
      "Но и здесь найдешь ты души,",
      "Помоги же им теперь.",
      "Тысяч ты дарить не в силах",
      "Для великого труда –",
      "Бог доволен бедной лептой,",
      "Что даешь ты для Христа."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ты не можешь проповедать:",
      "Бог не всем сей дар дает,",
      "Но рассказывать ты можешь,",
      "Как Он грешников зовет.",
      "Станем, братья, все трудиться,",
      "Сердце ревностью зажжем,",
      "И к Спасителю Иисусу",
      "Много душ мы приведем."
     ]
    }
   ]
  },
  {
   "src": "p0239.png",
   "num": "253",
   "title": "Богу слава и хваленье",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Богу слава и хваленье",
      "За всех избранных мужей,",
      "Что несли в мир просвещенье",
      "С древних лет до наших дней."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О Господь! И нам дай силы",
      "В мир нести Твой жизни свет,",
      "Чтоб мы были Даниилы",
      "В Вавилоне зла и бед."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Высшей жизни пионеры",
      "Вот: Енох, Ной, Авраам,",
      "Моисей – герой, муж веры,",
      "Даниил, Сын Божий Сам."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Для прогресса и культуры",
      "Сдвиг в сих людях мир нашел,",
      "Чрез великие натуры",
      "Свыше свет к нам в мир пришел."
     ]
    }
   ]
  },
  {
   "src": "p0240.png",
   "num": "254",
   "title": "Воспряньте, братья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Воспряньте, братья, бодро",
      "Уж с раннего утра,",
      "Работайте прилежно –",
      "Славен труд добра.",
      "Сейте вы правды семя,",
      "Спешите, дни пройдут.",
      "Быстро проходит время, –",
      "Кончен будет труд."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Воспряньте, братья, дружно",
      "Трудитесь среди дня,",
      "На труд сей всем нам нужно",
      "Посвятить себя.",
      "О вы, рабы Христовы,",
      "Придите помогать;",
      "И будьте все готовы",
      "Призыву внимать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Воспряньте, братья, смело,",
      "Пока не кончен день,",
      "Примитесь все за дело, –",
      "Близка ночи тень.",
      "Всем людям укажите,",
      "Как быстро дни текут;",
      "Все силы приложите –",
      "И закончим труд."
     ]
    }
   ]
  },
  {
   "src": "p0241.png",
   "num": "255",
   "title": "С берегов далеких стран",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "С берегов далеких стран",
      "Раздается зов всем нам:",
      "\"О придите научить",
      "Богу в истине служить!\""
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О друзья, пойдем скорее",
      "К людям темным в край иной",
      "Возвестить им путь спасенья!",
      "О прощай, мой дом родной!"
     ]
    }
   ]
  },
  {
   "src": "p0242.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "\"Бог живой неведом нам,",
      "Служим мы земным богам;",
      "О придите свет пролить",
      "И от тьмы освободить!\""
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Слушай, друг! – вот призыв тот",
      "О спасенье вопиет.",
      "Ты и силен, и здоров,",
      "Так откликнись же на зов."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Поспешите же, друзья,",
      "И отправьтесь за моря,",
      "Им открыть любовь Отца,",
      "Вседержителя Творца."
     ]
    }
   ]
  }
 ]
}