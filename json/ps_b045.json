 "songs": [
  {
   "src": "p0248.png",
   "num": "261",
   "title": "Вперед, Божий раб!",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Вперед, Божий раб! Трудись на земле,",
      "Свой путь совершай до конца.",
      "Сам Господь охранять поручает тебе",
      "Знамя истины и добра."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Там во славе Отца",
      "Будем мы тогда,",
      "В обителях светлых Христа,",
      "Там во славе Отца",
      "Будем мы тогда,",
      "Там будем мы навсегда."
     ]
    }
   ]
  },
  {
   "src": "p0249.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Будь тверд, Божий раб, борись за Христа,",
      "Спасения шлем возложи,",
      "Меч духовный пусть будет с тобою всегда,",
      "С ним ты в битву смелей иди."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Смелей, Божий раб, борись до конца,",
      "Победа уж ждет впереди;",
      "Хор небесный нас встретить готов у Отца",
      "От печалей, невзгод вдали."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "О восторг, торжество, радость вечной любви",
      "Влечет нас вослед за Христом!",
      "Уж слышно – там песни раздались вдали,",
      "Уже близок наш вечный дом."
     ]
    }
   ]
  },
  {
   "src": "p0249.png",
   "num": "262",
   "title": "О где же жнецы?",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О где же жнецы, чтоб поля пожать,",
      "Колосья добра средь греха собрать?",
      "Берите скорее любви серпы,",
      "С полей зла несите добра снопы."
     ]
    }
   ]
  },
  {
   "src": "p0250.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Где же жнецы, где? О кто готов",
      "Откликнуться радостно на Божий зов?",
      "Кто хочет жать здесь снопы добра,",
      "Для житниц неба с полей греха?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ищите, ищите среди травы,",
      "Колосья меж терний найдете вы.",
      "Спешите собрать для Христа скорей",
      "Искупленных Богом Его детей."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Поля уж созрели, работа ждет,",
      "Уж жатвы великий час настает.",
      "Но мало на ниве Христа жнецов",
      "Сбирают колосья с полей грехов."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Бери же свой серп и на труд иди,",
      "На ниве созревшей вяжи снопы.",
      "Трудись, вот уж скоро Господь",
      "Награду всем верным жнецам несет."
     ]
    }
   ]
  },
  {
   "src": "p0251.png",
   "num": "263",
   "title": "Воины рати Христовой!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Воины рати Христовой!",
      "Смело и дружно пойдем вперед!",
      "Дни наступили суровы,",
      "Нас испытание ждет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Воины рати Христовой!",
      "Смело и дружно вперед!",
      "Дни наступили суровы,",
      "Нас испытание ждет."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Нам испытание нужно,",
      "Чтобы окрепнуть в земной борьбе:",
      "Стойте же, братья, все дружно,",
      "Силы просите себе (да себе)."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Враг наш – лукавый воитель –",
      "В ярости хочет нас погубить,",
      "Но наш защитник – Спаситель,",
      "Сможем мы с Ним победить (победить)."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Он – Вождь великий и чудный,",
      "Сам этот мир славно победил,",
      "И нам дарует победу",
      "Именем Господа сил (Бога сил)."
     ]
    }
   ]
  },
  {
   "src": "p0252.png",
   "num": "264",
   "title": "Все к труду, все к труду! О вы, слуги Творца",
   "complete": false,
   "blocks": [
