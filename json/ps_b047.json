 "songs": [
  {
   "src": "p0258.png",
   "num": "269",
   "title": "Дни жизни",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Дни жизни нам даны для трудов святых,",
      "Так посвятим Христу время дней земных,",
      "Лишь Ему избыток весь чувств и сил своих, –",
      "Трудитесь для Иисуса."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Все трудитесь, все трудитесь,",
      "Быстро проходят дни труда;",
      "В вечность уходят навсегда;",
      "Силою крепитесь, духом ободритесь,",
      "Все для Христа трудитесь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дни жизни нам даны труд святой свершать,",
      "Всех опечаленных в мире утешать,",
      "Вестью искупления гибнущих спасать, –",
      "Трудитесь для Иисуса."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Дни жизни нам даны со Христом прожить,",
      "И праведно во всем пред Творцом ходить,",
      "Господа во всех делах славить и хвалить, –",
      "Трудитесь для Иисуса."
     ]
    }
   ]
  },
  {
   "src": "p0259.png",
   "num": "270",
   "title": "Воины Христовы",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Воины Христовы!",
      "Шествуя, как в бой,",
      "Будьте все готовы",
      "Вы к войне святой.",
      "Враг наш, враг лукавый,",
      "Хитро бой ведет,",
      "Но оружьем правды",
      "Бог нас облечет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Воины Христовы!",
      "Шествуя, как в бой,",
      "Облекитесь в броню",
      "Истины святой."
     ]
    }
   ]
  },
  {
   "src": "p0260.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Божий меч духовный, веры щит живой,",
      "Взяв, и в мир греховный выйдем смело в бой,",
      "Знамя правды вечной вознеся в сердцах,",
      "Мы с Вождем предвечным победим весь страх."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И при звуке трубном, победивши грех,",
      "Вскоре Вождь наш чудный призовет нас всех.",
      "И введет в край счастья, возложив венец,",
      "О бодритесь, братья, – близок уж конец."
     ]
    }
   ]
  },
  {
   "src": "p0260.png",
   "num": "271",
   "title": "Стражи Сиона, вы громче трубите",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Стражи Сиона, вы громче трубите,",
      "Мир окончательно хочет заснуть.",
      "О пробудите его, пробудите:",
      "Близится утро, кончается путь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В мир сей идите с святым возвещеньем,",
      "Пусть Весть Благая повсюду пройдет,",
      "Всем расскажите с святым вдохновеньем,",
      "Что уж Спаситель с Сиона грядет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пусть приготовится тот, кто желает",
      "В Царство Христово спасенным войти,",
      "Пусть он немедля за Ним поспешает,",
      "Времени мало уже впереди."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Стражи Сиона, вы громче трубите,",
      "Свет ваш пусть пламенем ярким горит;",
      "Всех, всех с любовью к Иисусу зовите –",
      "Вас за труды Бог в сто крат наградит."
     ]
    }
   ]
  },
  {
   "src": "p0261.png",
   "num": "272",
   "title": "Неверья ночь все обняла",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Неверья ночь все объяла,",
      "Густая тьма покрыла все края.",
      "Там, где Христа ученье не царит,",
      "Безбожья мгла сердца людей пленит."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Взгляни, как негр желает знать,",
      "Что Бог пришел с небес его спасать,",
      "Индеец, австралиец, эскимос –",
      "Всех от греха спасти пришел Христос."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пролейте свет и в их сердца,",
      "Скажите им о милости Христа, –",
      "Спаситель и за них ведь умирал",
      "И путь из тьмы грехов им указал."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Скажите им, что наш Христос",
      "Их преступленья на Себе понес.",
      "Ведите их из мрака и греха",
      "В небесный дом, в обители Отца."
     ]
    }
   ]
  },
  {
   "src": "p0262.png",
