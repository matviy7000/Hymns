 "songs": [
  {
   "src": "p0268.png",
   "num": "279",
   "title": "О смертный, внимай!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О смертный, внимай! Ведь суд уж начался,",
      "Суд с дома Божьего идет,",
      "Краткий период лишь остался,",
      "И Судья воздать придет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Кто устоит перед судом?",
      "Как устоим и ты, и я?",
      "Все мы предстанем пред престолом,",
      "Что скажет нам в тот день Судья?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Тысяча восемьсот сорок четвертый –",
      "Это суда начальный год,",
      "Судятся ныне те, кто мертвы,",
      "И для тебя придет черед."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О, кто устоит пред судным разбором?",
      "Взвесит всю нашу жизнь Судья,",
      "Всякий мой грех в делах иль словом.",
      "Устою ли в день тот я?"
     ]
    }
   ]
  },
  {
   "src": "p0269.png",
   "num": "280",
   "title": "И для нас пора настала",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "И для нас пора настала,",
      "Бог теперь зовет к труду –",
      "Мир спасать от смерти жала,",
      "Посвятись Ему.",
      "Иисус живит сознанье,",
      "Обещал нам помощь дать,",
      "И горит в нас лишь желанье",
      "Бога прославлять."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Те, кто в жизни постарался",
      "Возвестить призыв сей нам,",
      "С трудностями не считался,",
      "Как Спаситель Сам.",
      "Божье приняли веленье",
      "И трудились много лет,",
      "При страданьях и гоненьях,",
      "Проливая свет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Так и нас та весть благая",
      "Всех на труд святой зовет,",
      "Скажем вместе, это зная:",
      "\"Наша рать идет!\"",
      "Полны силы, полны рвенья,",
      "Славно мы свой труд свершим,",
      "Вестью Божьей о спасенье",
      "Мир весь озарим."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "\"Я готов!\" – скажи смелее, –",
      "\"О Господь, пошли меня!"
     ]
    }
   ]
  },
  {
   "src": "p0270.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Буду ревностно трудиться",
      "До кончины дня!\""
     ]
    }
   ]
  },
  {
   "src": "p0270.png",
   "num": "281",
   "title": "Народы, люди, племена!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Народы, люди, племена!",
      "Убойтесь Господа, Творца, –",
      "Ведь час суда настал!",
      "Воздайте славу вы Ему",
      "И поклонитесь лишь Тому,",
      "Кто Словом мир создал."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Познайте, пал уж Вавилон,",
      "Великий город в мире он,",
      "Бегите из него!",
      "Он против Бога согрешил,",
      "Вином народы напоил",
      "Ученья своего."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Кто зверю поклоняется,",
      "Кем образ почитается,",
      "Наказан будет тот;",
      "Кто принял начертание,",
      "Дав зверю тем признание,",
      "Навеки тот умрет."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Придите ж все к Христу скорей,",
      "Ведь Он лишь умер за людей,",
      "Пролив Святую кровь.",
      "И скоро в славе Он придет,",
      "Своих детей Он соберет, –",
      "О дивная любовь!"
     ]
    }
   ]
  },
  {
   "src": "p0271.png",
   "num": "282",
   "title": "Во всех краях земли",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Во всех краях земли звучит благая весть:",
      "\"Воздайте Господу хвалу и славу, честь.",
      "Ведь только Он – наш Бог, наш Властелин, Отец,",
      "Земли и неба Он Творец\"."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "И эту весть несут с небес",
      "Три ангела по всей земле:",
      "\"Убойтесь Господа, Творца небесных сил,",
      "Ведь час суда уж наступил\"."
     ]
    }
   ]
  },
  {
   "src": "p0272.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В грехах погряз и пал великий Вавилон,",
      "И наказание от Бога примет он.",
      "\"О выйди из него, искупленный народ\", –",
      "Так голос ангелов зовет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Надменный, лютый зверь здесь на земле царит,",
      "На поклонение к нему народ спешит.",
      "Но кто поклонится и примет знак его,",
      "Постигнет Божий гнев того."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "В великий судный день тот только устоит,",
      "Кто Божью заповедь и веру сохранит.",
      "Во славе в облаках Спаситель наш придет,",
      "Нас в Царство вечное введет."
     ]
    }
   ]
  },
  {
   "src": "p0272.png",
   "num": "283",
   "title": "Путь ко спасенью",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Путь ко спасенью новый, живой,",
      "Жертвой Христа открыт пред тобой.",
      "Он в храм на небе с кровью вступил,",
      "Нас с Богом примирил."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Радость, радость ныне грешным нам,",
      "Ведь за нас Христос Ходатай там,",
      "В храме небесном Он предстоит,",
      "Прощенье нам дарит."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Первосвященник в небе Христос,",
      "За нас туда Он кровь Свою внес;",
      "С Божьим законом я примирен,",
      "Жертвой Христа спасен."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Скоро закроют дверь в храм святой,",
      "Скоро окончит Он подвиг Свой.",
      "О поспешите к Богу прийти,",
      "Верою в храм войти."
     ]
    }
   ]
  }
 ]
}