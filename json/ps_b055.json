    {
     "label": "ПРИПЕВ",
     "lines": [
      "О приди к Христу, о приди к Христу,",
      "Бедный, утружденный, о приди к Христу!",
      "О приди к Христу, о приди к Христу,",
      "Бедный, утружденный, о приди к Христу!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Те сладостные звуки",
      "Влекут нас к небесам,",
      "Где мы забудем муки,",
      "Найдем покой сердцам.",
      "Тревогу и сомненья,",
      "Мой друг, ты победи,",
      "И слушай зов спасенья,",
      "Тот зов Христа: \"Приди!\""
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О Боже, дай мне силы",
      "Принять небесный зов,",
      "Чтоб верным до могилы",
      "Я был бы раб Христов.",
      "И там на небе новом",
      "У Агнца на груди",
      "Услышать дай мне снова",
      "Тот нежный зов: \"Приди!\""
     ]
    }
   ]
  },
