 "songs": [
  {
   "src": "p0322.png",
   "num": "333",
   "title": "О смотрите, время потоком льет",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О смотрите, время потоком льет,",
      "В море вечности спешит;",
      "Весть спасенья мощно к концу ведет,",
      "И по правде ее Бог завершит."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О уж скоро Господь с небес придет",
      "И всем верным награду принесет;",
      "О скорей же будь готов,",
      "Избранный Израиль, вновь,",
      "Чтоб встречать в мире Бога твоего."
     ]
    }
   ]
  },
  {
   "src": "p0323.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Несмотря на тяжесть последних времен,",
      "Во всем мире есть народ, –",
      "В послушанье Богу он посвящен,",
      "Верно Заповеди Его блюдет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Скоро поздно будет, мой друг, тебе,",
      "Чтобы милость умолять;",
      "О, ищи же Бога теперь в мольбе,",
      "Чтоб пред Ним на суде мог устоять."
     ]
    }
   ]
  },
  {
   "src": "p0323.png",
   "num": "334",
   "title": "Валтасар пир устроил",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Валтасар пир устроил",
      "Тысячам вельмож своих;",
      "Из сосудов храма пили",
      "Они чистых и святых.",
      "И когда ночь настала,",
      "Вдруг явилась им рука,",
      "На стене что-то писала, –",
      "В ужас все пришли тогда."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Это Божья рука на стене!",
      "Это Божья рука на стене!",
      "Она пишет: \"Вот ты взвешен,",
      "И как ты легок найден!\"",
      "Божья рукопись, вот, на стене!"
     ]
    }
   ]
  },
  {
   "src": "p0324.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Смелость зри Даниила, –",
      "В зале пышной он стоит,",
      "Царю гордому приводит",
      "Грех его, что он творит:",
      "Рукопись объясняет, –",
      "Суд царю написан был.",
      "Конец царству наступает, –",
      "Приговор тот так гласил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Веру зри Даниила, –",
      "Дух Святой Себя являл,",
      "Силу дал, чтоб непреклонно",
      "Он за истину стоял;",
      "У себя ль в Иудее,",
      "Пред царем ли тут в дворце,",
      "Он читает Божью надпись,",
      "Что сияла на стене."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "О, дела отмечает",
      "Всех рука та и теперь,",
      "Грешник, сердце дай Иисусу",
      "И любви Его поверь.",
      "День суда наступает,",
      "Вот уж близко он к тебе,",
      "Бог суд грешным назначает,",
      "О, подумай о себе!"
     ]
    }
   ]
  },
  {
   "src": "p0325.png",
   "num": "335",
   "title": "В день, когда труба Господня",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В день, когда труба Господня",
      "Всех пред Ним нас соберет,",
      "Встретимся ль мы в небе у кристальных вод (чистых вод)?",
      "Там на брачную вечерю",
      "Иисус Христос введет",
      "Многочисленный, бессмертный Свой народ."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О какая встреча будет,",
      "Вечно там народ пребудет."
     ]
    }
   ]
  },
  {
   "src": "p0326.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Избавленье возвестит глас трубный нам (трубный нам).",
      "Там мы встретим наших близких",
      "Среди райских рощ тенистых.",
      "Неразлучны будем мы навеки там."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Возвестит Господний ангел:",
      "\"Времени уж больше нет!\"",
      "И восхищены мы будем в облаках (в облаках),",
      "Там на нас Творец Вселенной",
      "Изольет Свой дивный свет.",
      "О, как счастливы мы будем в небесах!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Все, что тайно и сокрыто,",
      "В день явления Его",
      "Будет явно и открыто пред судом (пред судом).",
      "Скажет праведным: войдите",
      "В радость Бога своего!",
      "О, какое там блаженство мы найдем!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Там при звуках гуслей стройных,",
      "Арф небесных золотых,",
      "Гимн победы в день спасенья воспоем (воспоем),",
      "Песню Агнца, Моисея",
      "С сонмом праведных, святых, –",
      "Песнь, неведомую миру, мы споем!"
     ]
    }
   ]
  }
 ]
