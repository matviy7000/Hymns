 "songs": [
  {
   "src": "p0327.png",
   "num": "336",
   "title": "Быть может и в час",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Быть может, и в час, когда ранней зарею",
      "Пробьется луч солнца над грешной землею,",
      "Придет наш Господь, окружен вечной славой,",
      "Собрать от земли Своих."
     ]
    }
   ]
  },
  {
   "src": "p0328.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "О Спаситель, мы ждем,",
      "Когда пред Тобой воспоем.",
      "Аллилуйя, Он грядет к нам,",
      "Аллилуйя! Аминь.",
      "Аллилуйя! Аминь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Быть может, и в час, когда мрак полуночи",
      "Все тьмою покроет, сомкнет наши очи,",
      "Придет наш Господь, светом молний блистая,",
      "Собрать от земли Своих."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О радость, о счастье, от смерти спасенным,",
      "От недугов тяжких навек исцеленным,",
      "Быть в вечную славу Его восхищенным,",
      "Куда Он возьмет Своих."
     ]
    }
   ]
  },
  {
   "src": "p0329.png",
   "num": "337",
   "title": "Рассветает свет с востока",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Рассветает свет с востока,",
      "Озарился неба свод, –",
      "В дивной милости высокой",
      "Бог судить сей мир грядет.",
      "Нерадивого погубит,",
      "Но спасет Своих детей;",
      "Он один судить их будет",
      "Вечной правдою Своей."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Вот грядет Господь со славой",
      "Суд над миром совершать,"
     ]
    }
   ]
  },
  {
   "src": "p0330.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "И возмездие всем смертным",
      "По делам их им воздать."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Кто трезвится, ожидает",
      "Этого святого дня,",
      "Тем Он царство обещает,",
      "Где не будет больше зла.",
      "Но постигнут тех укоры,",
      "Кто идет путями зла,",
      "Отвергает правду Слова,",
      "Добрые Его дела."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Содрогнется самый храбрый",
      "Из героев жизни сей,",
      "Хоть и силою могучей",
      "Покорял себе людей.",
      "В день великий, день решенья,",
      "Бог с небесной высоты",
      "Даст Свое определенье.",
      "Что же, друг, получишь ты?"
     ]
    }
   ]
  },
  {
   "src": "p0330.png",
   "num": "338",
   "title": "О подумай, друг, об этом",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О подумай, друг, об этом,",
      "Что нам всем должно предстать",
      "Пред судом Христа с ответом,",
      "И во всем отчет отдать."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Справедливо, по закону",
      "Суд Господь произведет,",
      "Все рассмотрит неуклонно,",
      "Все Он взвесит и учтет."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Каждому из нас награду",
      "Бог назначит по делам:",
      "Праведным – небес отраду,",
      "Нечестивым – стыд и срам."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "О мой друг, пока не поздно,",
      "С Богом вечным примирись;",
      "До суда, пока возможно,",
      "От грехов освободись!"
     ]
    }
   ]
  },
  {
   "src": "p0331.png",
   "num": "339",
   "title": "Владыка жизни у дверей",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Владыка жизни у дверей, –",
      "Тот, Кто за грешных крест понес,",
      "Грядет собрать Своих детей",
      "С долины скорбных слез."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "У дверей, у дверей, у дверей,"
     ]
    }
   ]
  }
 ]
}