 "songs": [
  {
   "src": "p0332.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Стоит Он у дверей,",
      "Он грядет к нам, Он грядет к нам",
      "Для спасения людей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Знаменья убеждают нас,",
      "Все умножаясь с каждым днем,",
      "Что близок, близок славный час,",
      "Который мы все ждем."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Здесь, в мире, нет отрады нам,",
      "Жизнь горе, страх и скорбь дарит;",
      "Когда ж придет Спаситель Сам –",
      "Все счастьем озарит."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Господь всю землю обновит,",
      "Там вечно мы пребудем все,",
      "И в райской славе будем жить,",
      "Ходить в святой красе."
     ]
    }
   ]
  },
  {
   "src": "p0333.png",
   "num": "340",
   "title": "Не знает никто",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Не знает никто час Христова явленья,",
      "Но все говорит о Его приближенье;",
      "Уж скоро с небес Он придет для спасенья,",
      "Но тот час не открыт."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Он грядет! Будьте бодры, молитесь!",
      "Он грядет! Аллилуйя! Аллилуйя!",
      "Он грядет в облаках и во славе небесной,",
      "Но тот час не открыт!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Господь Своих слуг по земле рассылает,",
      "Пророчества свет всем глаза открывает, –",
      "Что близок конец, грозный час наступает,",
      "Близок миру конец."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Так бодрствуй, о брат, твой светильник духовный",
      "Пусть ярче горит здесь во мраке греховном;",
      "Трудись и молись и, венцом награжденный,",
      "Встретишь Господа сил."
     ]
    }
   ]
  },
  {
   "src": "p0334.png",
   "num": "341",
   "title": "Внемли, вот весть Господь дает",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Внемли, вот весть Господь дает,",
      "Что скоро Он придет,",
      "Великий грозный день суда",
      "Настанет всем тогда."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "В тот день, в тот день,",
      "В день Божьего суда,",
      "Решит Он все и навсегда.",
      "Что скажешь ты тогда?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он будет праведно судить",
      "И всех вознаградит.",
      "Припомнит все твои дела",
      "В день грозного суда."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Там оправданья больше нет,",
      "Закон там свят и строг.",
      "Какой ты дашь тогда ответ,",
      "Коль жизнь полна грехов?"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Внемли, мой друг, Бог весть дает,",
      "К Себе Он всех зовет.",
      "И кто Его путем идет,",
      "На суд тот не придет!"
     ]
    }
   ]
  },
  {
   "src": "p0335.png",
   "num": "342",
   "title": "Когда ж пробьет нам час?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Когда ж пробьет нам час блаженный?",
      "Когда Господь придет опять?",
      "Когда мы все Его явленье",
      "С восторгом будем прославлять?",
      "Когда Он мне доставит счастье",
      "Узреть Его лицом к лицу!?",
      "Когда ж меня в Свои объятья",
      "Он примет, как Свою овцу?"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Приди ж, Владыка жизни, властно",
      "На брачный пир нас всех веди;",
      "Не дай, чтоб Твой народ напрасно",
      "Томился от Тебя вдали.",
      "Христос, гостями называя,",
      "Нас приготовь в явленья день,",
      "И благодатью украшая,",
      "В одежды брачные одень."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Господь, ускорь конец томленью,",
      "Излей блаженства полноту,",
      "Закончи дело искупленья,",
      "Даруй нам сердца чистоту,",
      "Когда ж на вечери блаженной",
      "Мы все предстанем пред Тобой,",
      "Тебя мы, Твой народ спасенный,",
      "Прославим вечною хвалой."
     ]
    }
   ]
  },
  {
   "src": "p0336.png",
   "num": "343",
   "title": "День Господень наступает",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "День Господень наступает,",
      "Издали уж виден свет,",
      "И всех спящих пробуждает",
      "Утра радостный рассвет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Призыв слыша, все мужайтесь,",
      "Меч духовный обнажив!",
      "Вы за Господа сражайтесь,",
      "Силы к битве Божьей укрепив."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Всех гонимых, угнетенных,",
      "Пострадавших за Христа,",
      "Призывают под знамена",
      "Божьей истины уста."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Все оружие примите,",
      "Дабы в битве устоять,",
      "Броню правды возложите",
      "Стрелы вражьи отражать."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Вождь – Христос, закон свободы –",
      "Вечный к нам Его завет;",
      "Да познают все народы",
      "Чудный, славный Божий свет."
     ]
    }
   ]
  }
 ]
