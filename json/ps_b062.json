 "songs": [
  {
   "src": "p0337.png",
   "num": "344",
   "title": "Пред нами, братья, Иордан",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Пред нами, братья, Иордан,",
      "Пустыню мы прошли,",
      "Вдали уж виден Ханаан,",
      "К нему мы подошли."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "В той стране после скорбей отдохнем, отдохнем,",
      "Перейдя через бурный Иордан,",
      "Песню Агнца, Моисея там воспоем,",
      "Огласим пеньем Ханаан."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И Иерихон могуч падет,",
      "И станет Иордан,",
      "Когда Господь Сам поведет",
      "Народ Свой в Ханаан."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Немного нам еще здесь ждать",
      "У бурных берегов,",
      "Услышим зов в тот край вступать",
      "Мы скоро с облаков."
     ]
    }
   ]
  },
  {
   "src": "p0338.png",
   "num": "345",
   "title": "Как быстро день за днем летит",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Как быстро день за днем летит",
      "С поспешностью вперед,",
      "Чуть утром солнце заблестит –",
      "И ночь уж настает."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Час за часом, день за днем",
      "Быстро мы к концу идем;",
      "Вот последний час пробьет –",
      "И Спаситель наш придет."
     ]
    }
   ]
  },
  {
   "src": "p0339.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Так быстро наши дни пройдут,",
      "Исчезнут все, как пар,",
      "И нас к могиле подведут –",
      "Отдать злой смерти дар."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Но кто здесь в мире жил с Христом",
      "И веру сохранил,",
      "Того Христос в Отцовский дом",
      "Возьмет чрез мрак могил."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Быть может, скоро для меня",
      "Пробьет последний час,",
      "И лишь для вечного житья",
      "Пробудит Божий глас."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Так помоги, Спаситель мой,",
      "Мне жизнь здесь так прожить,",
      "Чтобы навеки пред Тобой",
      "Тебе хвалой служить."
     ]
    }
   ]
  },
  {
   "src": "p0339.png",
   "num": "346",
   "title": "В день последний воскресенья",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "В день последний воскресенья,",
      "Сбросив смертный сон забвенья,",
      "Мы узрим Христа явленье",
      "С неба с славою Отца."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Мы воскреснем! Мы воскреснем!",
      "Что за радость в день спасенья будет нам (будет нам)!",
      "Мы воскреснем! Аллилуйя!",
      "Мы воскреснем! Аллилуйя!",
      "Вознесет Господь спасенных к небесам."
     ]
    }
   ]
  },
  {
   "src": "p0340.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В славе новой мы проснемся,",
      "Все в нетленье облечемся",
      "И к престолу вознесемся,",
      "В те обители Отца."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Там с восторгом небу скажем,",
      "Сонмам ангелов расскажем,",
      "Как Христос принял страданья,",
      "Как нас спас и оправдал."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Там мы всех друзей узнаем",
      "И лицом к лицу познаем,",
      "Кто был нашим упованьем,",
      "Кто нас к вечности призвал."
     ]
    }
   ]
  },
  {
   "src": "p0341.png",
   "num": "347",
   "title": "Затрубит труба Господня",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Затрубит труба Господня в день пришествия Христа",
      "И во славе наш Господь с небес придет,",
      "Он пробудит всех спасенных, спящих в прахе, от их сна.",
      "Имя там мое Христос Сам назовет."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Затрубит труба Господня в день Христа,"
     ]
    }
   ]
  }
 ]
