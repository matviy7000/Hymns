 "songs": [
  {
   "src": "p0352.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "ПРИПЕВ",
     "lines": [
      "В книге жизни предвечной",
      "Наше имя вписал."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Агнец грех мой прощает",
      "Весь, как есть, без числа,",
      "И во всем помогает,",
      "Охраняя от зла;",
      "И когда я молюся,",
      "Он ведь внемлет мольбам, –",
      "Верю я Иисусу,",
      "Что записан я там."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В город улиц жемчужных,",
      "Ярче светлого дня,",
      "В город стен изумрудных",
      "Бог введет и меня.",
      "Там во славе чудесной",
      "Песнь хвалы я воздам,",
      "Что в той книге небесной,",
      "Да, записан я там."
     ]
    }
   ]
  },
  {
   "src": "p0352.png",
   "num": "356",
   "title": "Я стремлюсь лишь к жизни вечной",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Я стремлюсь лишь к жизни вечной, –",
      "Там найду покой;",
      "Я борюсь здесь бесконечно",
      "За Тебя, Бог мой!",
      "Не удержит мир меня,",
      "Я надеюсь на Тебя",
      "И иду к святой Отчизне",
      "Вечного Отца."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты зовешь, но будет время,",
      "Перестанешь звать, –",
      "Поспешу в благое время,",
      "Чтоб не опоздать.",
      "Ко Христу кто не спешит,",
      "Тех награды Он лишит;",
      "Я иду, и Он венец мне",
      "Золотой дарит."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О, направь мои желанья",
      "К цели дорогой,",
      "Подкрепи меня в скитанье",
      "В жизни сей земной.",
      "Манит мир – Ты привлекай,",
      "Обижает – утешай",
      "И прямым путем тернистым",
      "К цели направляй."
     ]
    }
   ]
  },
  {
   "src": "p0353.png",
   "num": "357",
   "title": "О, брат мой, куда так стремишься?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О, брат мой, куда так стремишься,",
      "Ведь путь твой скорбями ведет?",
      "Ты, разве, сестра, не страшишься",
      "Напастей, беды и невзгод?",
      "Наш путь хоть тернистый и трудный,",
      "Все ж бодро, без страха идем,",
      "И скоро в край Родины чудной,",
      "В родной Ханаан мы придем."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Наш путь уже близок к концу.",
      "Стремимся домой мы, к Отцу;",
      "И там, на Сионе, в восторге",
      "Хвалу воздадим мы Творцу."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "О, брат и сестра, научите,",
      "Что делать, чтоб с вами пойти?",
      "Где сил почерпнуть, укажите,",
      "Чтоб к цели блаженной дойти?",
      "Дух Божий дает нам влеченье",
      "Стремиться вперед по пути;",
      "И бодрость, и силу, терпенье",
      "Дает нам, чтоб к цели дойти!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Друзья, я пойду вместе с вами,",
      "Нас примет Небесный Отец;",
      "Победу Он даст над грехами,",
      "Возложит на главы венец.",
      "Приветствуем всею душою",
      "Решенье твое к нам примкнуть;",
      "Теперь, в единенье с тобою,",
      "Мы с верой отправимся в путь!"
     ]
    }
   ]
  },
  {
   "src": "p0354.png",
   "num": "358",
   "title": "Вся тварь, и небо, и земля",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Вся тварь, и небо, и земля, –",
      "Твое, Господь, творенье –",
      "Томится, ждет святого дня,",
      "Чтоб дал Ты избавленье.",
      "Рукой могучею Твоей",
      "С небес любовь Твою пролей,",
      "Пролей скорей, о Боже,",
      "Пролей скорей, о Боже!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Созижди в мире правды дом,",
      "Сними с нас поношенье, –",
      "Страдает все, везде, кругом,",
      "Пошли с небес спасенье.",
      "Величье славы всем яви,",
      "Греховный гнет со всех сними,",
      "Сними скорей, о Боже!",
      "Сними скорей, о Боже!"
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И царство правды и добра,",
      "Чтоб слез, скорбей не знали,",
      "Здесь в мире больше никогда",
      "Чтоб люди не страдали.",
      "Твоею силой, Боже наш,",
      "Создай то царство Ты для нас,",
      "Создай скорей, о Боже!",
      "Создай скорей, о Боже!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Наследье, Боже, мы Твое,",
      "Живем в греховном мире,",
      "Готовимся уже давно,",
      "Чтоб быть на брачном пире.",
      "Когда ж придешь, о Боже, к нам",
      "Отраду дать Твоим рабам?",
      "Гряди скорей, о Боже!",
      "Гряди скорей, о Боже!"
     ]
    }
   ]
  },
  {
