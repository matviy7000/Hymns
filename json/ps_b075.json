 "songs": [
  {
   "src": "p0406.png",
   "num": "405",
   "title": "О Боже, с любовью",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "О Боже, с любовью влеки нас к Себе,",
      "Пусть в наших сердцах будет место Тебе.",
      "Зажги в нас желанье ходить за Тобой",
      "И в скорби, и в радости жизни земной."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Мы с радостью гордость оставить хотим,",
      "Смиренье и кротость в терпенье взрастим.",
      "Ты жизнь эту так помоги нам прожить,",
      "Чтоб кротко, в смиренье друг другу служить."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пусть ссоры и гнев не приблизятся к нам,",
      "Христово смиренье и кротость дай нам,",
      "Как братья, смиренно прославив Тебя,",
      "Послужим с терпеньем, друг друга любя."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "К нам, Боже святой, с милосердьем пребудь,",
      "Направь нас, народ Твой, на истинный путь,",
      "От злых пожеланий очисти нас всех,",
      "Пусть к нам не пристанет уж более грех."
     ]
    }
   ]
  },
  {
   "src": "p0407.png",
   "num": "406",
   "title": "Господь, Ты полн смиренья",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Господь, Ты полн смиренья,",
      "В последний жизни час",
      "Оставил в поученье",
      "Пример Ты Свой для нас,",
      "Оставил в поученье",
      "Пример Ты Свой для нас."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты, Бог, Творец вселенной,",
      "Своим ученикам",
      "С любовию священной",
      "Им ноги омывал.",
      "С любовию священной",
      "Им ноги омывал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Дух кротости, служенья",
      "Взрасти в душе моей,",
      "Чтобы и я в смиренье",
      "Трудился для людей.",
      "Чтобы и я в смиренье",
      "Трудился для людей."
     ]
    }
   ]
  },
  {
   "src": "p0407.png",
   "num": "407",
   "title": "Смотри, Творец небес",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Смотри, Творец небес, земли Господь",
      "Учеников Своих собрал; затем",
      "Он, препоясавшись, воды берет,",
      "В смиренье Он им ноги моет всем."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Для падших нас в ужасный грех и тьму",
      "Свершил Ты это дело, Бог святой.",
      "Послушны все примеру Твоему,",
      "Мы молим: \"Дай иметь нам часть с Тобой!\""
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Не отрицай ученья свет благой,",
      "Христов пример нарушить не дерзай, –",
      "Ведь это дело – долг любви святой,",
      "Исполнить знак смиренья поспешай!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Ты всем рабам послушным обещал",
      "Твой Дух Святой, о Боже, ниспослать,",
      "Чтоб тот пример, который Ты нам дал,",
      "В смиренье истинном здесь исполнять."
     ]
    }
   ]
  },
  {
   "src": "p0408.png",
   "num": "408",
   "title": "Спаситель, мы собрались вновь",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Спаситель, мы собрались вновь",
      "Смерть вспоминать Твою,",
      "Что ради нас Ты пролил кровь,",
      "И жизнь отдал Свою."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Дай нам достойно приступить",
      "К участию сему,",
      "Прости все неугодное",
      "В нас Духу Твоему."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Чтоб испытать себя могли,",
      "Нас словом обличи,",
      "И правым мыслям и делам",
      "Нас ныне научи."
     ]
    }
   ]
  },
  {
   "src": "p0408.png",
   "num": "409",
   "title": "Для рук христианина",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Для рук христианина",
      "Нет униженья в том,",
      "Когда здесь, на чужбине,",
      "В смиренье служит он:",
      "Ведь наш Господь, Учитель",
      "Рабом стал для людей,",
      "Всех грешных Он, Спаситель,",
      "Принял в любви Своей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он, как Отец, сердечно",
      "Своими нас назвал;",
      "В залог нам жизни вечной",
      "Святого Духа дал.",
      "И если Бог служенье",
      "Тебе определил,",
      "Не чувствуй униженья:",
      "Он также ведь служил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Спаситель наш, Сын Бога,",
      "Велик и славен был,",
      "Но все ж в смиренье ноги",
      "Ученикам омыл.",
      "Не будем медлить, братья,",
      "Исполнить долг любви;",
      "Обильной благодати",
      "О Боже, нам пошли!"
     ]
    }
   ]
  },
  {
   "src": "p0409.png",
   "num": "410",
   "title": "Смотрите, Агнец Божий",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Смотрите, Агнец Божий без боязни,",
      "Страданий чашу горькую испив,",
      "Свой крест несет, идя к позорной казни,",
      "Страдает Он, нас грешных возлюбив.",
      "Он уж вблизи могильного порога,",
      "Но смерть встречает смелою душой;",
      "Он, как Посланник горнего чертога,",
      "На крест идет исполнить подвиг Свой."
     ]
    }
   ]
  },
  {
   "src": "p0410.png",
