 "songs": [
  {
   "src": "p0411.png",
   "num": "411",
   "title": "Уж близок был страданий час",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Уж близок был страданий час,",
      "Христос скорбел душой,",
      "И Он, собрав учеников,",
      "Открыл им подвиг Свой."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Он в руки взял тот чистый хлеб,",
      "В мольбе главу склонил, –",
      "И, раздавая в тишине,",
      "Пред ними преломил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "\"Примите хлеб, ядите все\", –",
      "Ученикам сказал, –",
      "На плоть Свою в страданиях",
      "Он тем им указал."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Потом и чашу взял с вином,",
      "Ее благословил,",
      "\"Прольется кровь Моя за вас\", –",
      "Христос им возвестил."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "\"Сие творите вы всегда,",
      "Тем помня смерть Мою,",
      "За вас, за вас, друзья Мои",
      "Ведь жизнь Я отдаю\"."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "Христос Спаситель, – молим мы, –",
      "Пребудь и среди нас,",
      "И дай нам помнить смерть Твою",
      "Всегда, во всякий час."
     ]
    }
   ]
  },
  {
   "src": "p0411.png",
   "num": "412",
   "title": "Страданья час",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Страданья час уж наступал,",
      "Когда Христос Своих собрал",
      "На вечерю, где им явил,",
      "Как сильно Он их возлюбил."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "И возлежав, Он хлеб берет,",
      "И преломив, им раздает:",
      "\"Примите и ядите все,",
      "Сие есть Тело вам Мое\"."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "В молитве съединясь с Отцом,",
      "Дает Он чашу им с вином:",
      "\"Примите, пейте все из ней,",
      "Сей есть завет в Крови Моей\"."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Послушны слову Твоему,",
      "Мы вспоминаем смерть Твою.",
      "Скорей, Спаситель наш, гряди",
      "И нас на брачный пир введи!"
     ]
    }
   ]
  },
  {
   "src": "p0412.png",
   "num": "413",
   "title": "Боже, на Твоей вечере",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Боже, на Твоей вечере",
      "Духом мы воспряли вновь.",
      "О, даруй нам силу веры,",
      "Благодать Твою, любовь."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В образ Твой преобразиться",
      "Помоги рабам Своим;",
      "Дай нам всем руководиться",
      "Словом вечным и святым."
     ]
    }
   ]
  },
  {
   "src": "p0412.png",
   "num": "414",
   "title": "Боже, Тобою мы собраны снова",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Боже, Тобою мы собраны снова",
      "Дланью Твоею вкруг чаши даров,",
      "Ждем от Тебя откровения слова,",
      "Тайны пред нами грядущих годов."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Боже, мы просим, представши в смиренье, –",
      "Все преступления наши прости;",
      "Даруй нам новую силу и рвенье",
      "Миру спасенье с любовью нести."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Духом всегда Ты пребудь между нами,",
      "Верой живою сердца нам согрей;",
      "Светом великим – пророков словами –",
      "Сделай стезю нашу в мире светлей."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Даруй вещать нам спасение смело;",
      "Робость, сомненье от нас изгони, –",
      "Все, что мешает великому делу,",
      "Силой могучею Сам устрани."
     ]
    }
   ]
  },
  {
   "src": "p0413.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Черные тучи великой невзгоды",
      "Грозно повисли над грешной землей;",
      "Мечутся всюду свирепо народы,",
      "Вновь затевая неверия бой."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "Ходит враг жизни, как лев разъяренный,",
      "Ищет, кого бы ему поглотить,",
      "Дай же, о Боже, чтоб раб Твой спасенный",
      "Словом Твоим мог его победить."
     ]
    },
    {
     "label": "7 КУПЛЕТ",
     "lines": [
      "Боже, Ты видишь, мы наги, мы нищи,",
      "Ревность исчезла из наших сердец, –",
      "Нас подкрепи здесь духовною пищей,",
      "Молим Тебя, всеблагой наш Отец."
     ]
    }
   ]
  },
  {
   "src": "p0413.png",
   "num": "415",
   "title": "Благодарим Тебя, наш Бог",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Благодарим Тебя, наш Бог,",
      "За всю любовь Твою.",
      "За то, что Ты свершить помог",
      "Нам Вечерю сию.",
      "За то, что Ты свершить помог",
      "Нам Вечерю сию."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Мы славим сердцем и душой",
      "Голгофский подвиг Твой, –",
      "Ведь Ты за нас там пострадал",
      "И жизнь Свою отдал.",
      "Ведь Ты за нас там пострадал",
      "И жизнь Свою отдал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "О, дай, Спаситель, нам ценить",
      "Тот дар Твоей любви;",
      "В грядущих днях Тебе служить",
      "Нас вновь благослови.",
      "В грядущих днях Тебе служить",
      "Нас вновь благослови."
     ]
    }
   ]
  },
  {
   "src": "p0414.png",
   "num": "416",
   "title": "Принесите десятины",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "\"Принесите десятины",
      "В дом хранилища ко Мне\", –",
      "Так Господь нас призывает,",
      "Говорит тебе и мне."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "\"Чтобы был духовной пищей",
      "Дом наполнен Мой святой;",
      "Чтоб, кто алчет правды Божьей,",
      "Утолить мог голод свой\"."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "\"Принесите десятины,",
      "Испытайте вы Меня, –",
      "Буду Я для вас защитой,",
      "От лукавых бед храня\"."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Не обкрадывайте Бога,",
      "Будьте верны перед Ним;",
      "Верный в малом примет право",
      "Над имением большим."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Будем, братья, все мы равны",
      "В приношении даров,",
      "И докажем этим к ближним",
      "Нашу чистую любовь."
     ]
    }
   ]
  },
  {
   "src": "p0415.png",
   "num": "417",
   "title": "С дарами все предстали",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "С дарами все предстали",
      "Пред Господа лицом;",
      "Сердца у всех сияли",
      "Любви святой огнем.",
      "И, вспоминая бедных,",
      "Всех страждущих земли,",
      "Все доброхотны были",
      "И дар свой принесли."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Кто радостно желает",
      "Всем ближним помогать,"
     ]
