 "songs": [
  {
   "src": "p0431.png",
   "num": "436",
   "title": "Дети, поспешите",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Дети, поспешите",
      "Ко Христу скорей!",
      "И вас всех обнимет",
      "Он в любви Своей."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "В день субботний вместе",
      "Нужно изучать",
      "То, что обещает",
      "В небе Он вам дать."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "К Богу вознесите",
      "Лепет уст своих",
      "И внимайте кротко",
      "Смыслу слов святых."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Библию откройте,",
      "Прочитайте в ней, –",
      "Лишь Христос Единый –",
      "Друг души моей."
     ]
    }
   ]
  },
  {
   "src": "p0431.png",
   "num": "437",
   "title": "Маленькие капли",
   "complete": false,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Маленькие капли,",
      "Зернышки песка"
     ]
    }
   ]
  },
  {
   "src": "p0432.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Образуют земли,",
      "Реки и моря."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Малые минуты",
      "Доброго труда",
      "Создают недели,",
      "Годы и века."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Маленькие ручки,",
      "Любящие труд,",
      "Маленькие ножки,",
      "Что не устают."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Маленькие глазки",
      "Учатся добру",
      "И готовы людям",
      "Облегчать нужду."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Маленький же грешник",
      "Горе всем несет,",
      "Не приносит пользы,",
      "К гибели идет."
     ]
    },
    {
     "label": "6 КУПЛЕТ",
     "lines": [
      "А дела благие",
      "К небу приведут",
      "Всех, кто любит Бога,",
      "Всех, кто Бога чтут."
     ]
    }
   ]
  },
  {
   "src": "p0432.png",
   "num": "438",
   "title": "Дети малые, внимайте!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Дети малые, внимайте!",
      "Вот Спаситель говорит:",
      "Детям вы не возбраняйте",
      "Быть со Мной, Меня любить.",
      "Детям вы не возбраняйте",
      "Быть со Мной, Меня любить."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "\"О, придите ко Мне, дети,",
      "Я ведь всех вас так люблю,",
      "Отворите ж сердца клети –",
      "И Я вас благословлю\".",
      "Отворите ж сердца клети –",
      "И Я вас благословлю\"."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Да, пойдем все, детки, дружно",
      "Ко Христу, Его хвалить, –",
      "Иисуса всем нам нужно",
      "Сердцем пламенно любить.",
      "Иисуса всем нам нужно",
      "Сердцем пламенно любить."
     ]
    }
   ]
  },
  {
   "src": "p0433.png",
   "num": "439",
   "title": "Друг, помни о Создателе",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Друг, помни о Создателе",
      "В дни юности златой,",
      "Пока ты полон силами",
      "И бодр еще душой!",
      "Друг, помни о Создателе",
      "В дни юности златой,",
      "Пока ты полон силами",
      "И бодр еще душой!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Настанут дни тяжелые,",
      "Померкнет солнца свет,",
      "Нагрянут тучи новые",
      "За дождиком вослед."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Нет в днях тех больше радостей,",
      "Лишь ропоты одни;",
      "Познать Творца все благости",
      "Не в силах будешь ты."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "И если жизнь окончится",
      "Без пользы, без добра, –",
      "На небе все припомнится",
      "В день Божьего суда."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Поэтому, о, юноша,",
      "Служить Ему начни,",
      "Пока ты полон радости",
      "И силами души."
     ]
    }
   ]
  },
  {
   "src": "p0434.png",
   "num": "440",
   "title": "Любит мой Иисус меня",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Любит мой Иисус меня,",
      "Это верно, знаю я;",
      "Всех детей к Себе зовет,",
      "Им спасение дает."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Любит мой Иисус меня,",
      "Это твердо знаю я."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Любит мой Иисус меня,",
      "Говорит мне Библия;",
      "На Голгофе Он страдал,",
      "Нам блаженство даровал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Любит мой Иисус меня,",
      "Исцеляет от греха.",
      "С неба Он на нас глядит,",
      "\"Я люблю вас\", – говорит."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Любит мой Иисус меня,",
      "Не оставит никогда;",
      "Нас к Себе Он всех влечет,",
      "В Царство Божие возьмет."
     ]
    }
   ]
  },
  {
