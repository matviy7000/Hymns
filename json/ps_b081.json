 "songs": [
  {
   "src": "p0436.png",
   "num": "?",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Избегай худого,",
      "За собой смотри!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Ты ведь непременно",
      "Худо сам творил,",
      "Так молись смиренно,",
      "Чтоб Господь простил."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "И когда опять ты",
      "Видишь – зло творят,",
      "Суд не совершай ты,",
      "А учись прощать."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Всем любовь являя,",
      "Говори друзьям,",
      "Что блаженство рая",
      "Бог дает детям."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Нас, детей, Он любит",
      "И хранит от зла,",
      "Кто послушен будет, –",
      "Примет в небеса."
     ]
    }
   ]
  },
  {
   "src": "p0436.png",
   "num": "443",
   "title": "Там с высот небесных",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Там с высот небесных",
      "Смотрит наш Отец",
      "На Своих детей здесь,",
      "На Своих овец."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Слышит наши просьбы",
      "Ночью Он и днем,",
      "Охраняет всех нас,",
      "Сторожит наш дом."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Он нам посылает",
      "Хлеб земной всегда,",
      "Он не оставляет",
      "Здесь нас никогда."
     ]
    }
   ]
  },
  {
   "src": "p0437.png",
   "num": "444",
   "title": "Мой Христос Спаситель",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Мой Христос Спаситель",
      "Умер за меня,",
      "И в Свою обитель",
      "Примет и меня."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Любит мой Спаситель",
      "Малое дитя,",
      "Любит Он и взрослых,",
      "Любит и меня."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Ангелы святые",
      "Охраняют нас",
      "Во все дни земные",
      "И во всякий час."
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "Будем славить Бога,",
      "Будем петь Ему,",
      "И к Его престолу",
      "Вознесем хвалу!"
     ]
    }
   ]
  },
  {
   "src": "p0437.png",
   "num": "445",
   "title": "Славьте, народы",
   "complete": true,
   "blocks": [
    {
     "label": "",
     "lines": [
      "Славьте, народы, Иисуса Христа!",
      "Славьте Всевышнего Бога Отца!",
      "Славьте! Славьте! Славьте Христа."
     ]
    }
   ]
  },
  {
   "src": "p0438.png",
   "num": "446",
   "title": "Как люблю я Иисуса!",
   "complete": true,
   "blocks": [
    {
     "label": "",
     "lines": [
      "Как люблю я Иисуса, Иисуса!",
      "Лишь Ему вовек служу я, ввек служу я!",
      "Вечно слава, слава!"
     ]
    }
   ]
  },
  {
   "src": "p0438.png",
   "num": "447",
   "title": "Осанна!",
   "complete": true,
   "blocks": [
    {
     "label": "",
     "lines": [
      "Осанна!",
      "Там у чистых вечных вод",
      "Воспою Тебе, Господь."
     ]
    }
   ]
  },
  {
   "src": "p0439.png",
   "num": "448",
   "title": "Христос, приди!",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "Христос, приди как в дни былые,",
      "Детей Своих благослови;",
      "Соедини их в дни земные",
      "Союзом мира и любви."
     ]
    },
    {
     "label": "ПРИПЕВ",
     "lines": [
      "Излей Свой мир",
      "На брачный пир",
      "И к нам как гость приди!",
      "Излей Ты Свой мир",
      "На брачный пир,",
      "И всех благослови!"
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Приди, лучом любви могучей",
      "Тревогу жизни устрани!",
      "И песней сладостных созвучий",
      "Ты сделай жизнь их во все дни."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Пребудь в союзе и в общенье",
      "Ты с нами, наш Отец благой,",
      "И ниспошли нам подкрепленье,",
      "Излей на них Твой Дух Святой!"
     ]
    },
    {
     "label": "4 КУПЛЕТ",
     "lines": [
      "И чтоб, живя в земной Отчизне,",
      "Могли Тебя они хвалить,",
      "Ты поучай их словом жизни,",
      "Как нужно верить и любить."
     ]
    },
    {
     "label": "5 КУПЛЕТ",
     "lines": [
      "Приди и щедрою рукою",
      "Излей Свои дары на них!",
      "Венцом и славой неземною,",
      "Господь, венчай детей Своих!"
     ]
    }
   ]
  },
  {
   "src": "p0440.png",
   "num": "449",
   "title": "Не хорошо быть человеку одному",
   "complete": true,
   "blocks": [
    {
     "label": "1 КУПЛЕТ",
     "lines": [
      "\"Не хорошо быть человеку одному!\"",
      "Творец благой, Ты Сам вначале так сказал,",
      "\"Помощника для жизни сотворим ему!\"",
      "И из ребра его жену ему создал."
     ]
    },
    {
     "label": "2 КУПЛЕТ",
     "lines": [
      "Но чтоб нам дать познать союз любви святой",
      "Ты Сам невесту здесь Себе, Господь, избрал,",
      "Чтоб приобресть ее, пожертвовал Собой,",
      "И нам пример любви Божественной подал."
     ]
    },
    {
     "label": "3 КУПЛЕТ",
     "lines": [
      "Благослови ж, Господь, здесь давших свой обет,",
      "В одно их слей любовью чистой и святой;",
      "Храни от бед их, дай любви им Твой завет,",
      "Пока придешь Ты их взять с Собой домой."
     ]
    }
   ]
  }
 ]
